rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin (requires custom claim or specific email)
    function isAdmin() {
       return request.auth != null && (request.auth.token.email.matches('.*admin.*') || request.auth.token.admin == true);
    }

    // Hackathons: Anyone can read, only Admins can write
    match /hackathons/{hackathonId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Courses: Anyone can read, only Admins can write
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Postmortems: Anyone can read, only Admins can write
    match /postmortems/{pmId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Bounties: Anyone can read, only Admins can write
    match /bounties/{bountyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Contests: Anyone can read, Auth users can create (propose), Admins can manage, Hosts can edit their own
    match /contests/{contestId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow delete: if isAdmin();
      allow update: if isAdmin() 
        || (request.auth != null && resource.data.host == request.auth.token.email)
        || (request.auth != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants']));
    }
    
    // Users: Users can read/write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Squadron: Anyone can read, Authenticated users can post, Owners/Admins can delete
    match /squadron/{docId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Incubator Ideas: Public read, Auth create, Voting allowed
    match /incubator_ideas/{ideaId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Challenge Registrations: Auth create
    match /challenge_registrations/{regId} {
      allow read, write: if request.auth != null;
    }
  }
}
