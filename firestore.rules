rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // Admin is a custom auth claim (set via scripts/set-admin-claim.mjs), not
    // a hardcoded email - lets us add/revoke admins without redeploying rules.
    function isAdmin() {
      // .get() with a default, not dot-access - a regular user's token has
      // no `admin` key at all (never had the claim set), and dot-accessing a
      // genuinely missing map key throws in rules, denying the ENTIRE
      // expression this is OR'd into (not just evaluating falsy).
      return isAuth() && request.auth.token.get('admin', false) == true;
    }

    // ---------- same-day reward window ----------
    // Daily Learning pays XP/coins only on the day a lesson is FOR. These build
    // today's date as an ISO string so it can be compared against the log's own
    // `date` field, which is a string - rules cannot parse a date out of a
    // string, so the comparison has to go the other way.
    //
    // IST (+05:30) is hardcoded because the programme is scheduled in IST: a
    // "Friday" lesson is Friday in Hyderabad regardless of where the student
    // is sitting. lib/dailyLearning.js's toISODate uses LOCAL date parts, so a
    // student in a very different timezone can disagree with this rule near
    // midnight and see their write rejected. That is the correct outcome for an
    // IST-scheduled programme, but it is a real edge case, not an oversight.
    function istNow() {
      return request.time + duration.value(330, 'm');
    }
    function pad2(n) {
      return n < 10 ? '0' + string(n) : string(n);
    }
    function istTodayStr() {
      return string(istNow().year()) + '-' + pad2(istNow().month()) + '-' + pad2(istNow().day());
    }
    // A log claiming no reward is always allowed through the date check - late
    // completions must still be recordable, they simply earn nothing.
    function isRewardFreeLog() {
      return request.resource.data.get('xpEarned', 0) == 0
          && request.resource.data.get('coinEarned', 0) == 0;
    }

    // ---------- content distribution: audiences ----------
    // See docs/CONTENT-ENGINE-ARCHITECTURE.md sections 4, 5 and 6a. Mirrors
    // readerAudiences()/audienceAllows() in devert-frontend/lib/audiences.js -
    // if you change one, change the other, or a consumer's query will return
    // documents this then denies (or, worse, the reverse).
    //
    // The flat-array shape is forced, not chosen: rules cannot join, get() caps
    // at 10 reads per request, and list queries must be statically provable, so
    // the institution/department/year/section hierarchy cannot be walked here.
    // It is expanded into flat strings at claim-minting time instead.
    // The claim is `auds`, NOT `aud`. `aud` is a RESERVED JWT claim holding the
    // Firebase project id (a string) - using it here made
    // token.get('aud', []) return that string, .size() return its character
    // length, and hasAny() receive a string instead of a list, which threw and
    // denied every authenticated read. Unauthenticated reads passed, so the bug
    // hid until an emulator test with a signed-in user caught it. Firebase's
    // Admin SDK also refuses to set reserved claims, so this would have failed
    // at mint time as well. Never rename this back.
    function readerAud() {
      // NOT an edge case: no account has an `auds` claim yet, so this fallback
      // is the state of every real user until claims are minted. `legacy` is in
      // it deliberately - published content is currently readable
      // UNAUTHENTICATED (the content reads below have no isAuth()), so omitting
      // it would break public reads of every existing lesson.
      return isAuth() && request.auth.token.get('auds', []).size() > 0
        ? request.auth.token.get('auds', [])
        : ['public', 'legacy'];
    }

    // DEFENCE IN DEPTH ONLY - exclusion is delivered by the consumer's
    // array-contains-any filter. Emulator probing found list() returning
    // documents that get() denies, contradicting the documented "rules are not
    // filters" model (doc section 6a), so nothing here relies on list()
    // enforcing this per document. What DOES hold unconditionally: `audiences:
    // []` can never match, because no string is a member of an empty array.
    //
    // .get('audiences', []) means a document with no such field is INVISIBLE.
    // That is the intended default for newly authored content, and it is safe
    // for existing content only because Phase 0 backfilled all 1,305 documents
    // (scripts/backfill-content-audiences.mjs). Gating a collection that has
    // NOT been backfilled will make it vanish - check before adding one.
    function audienceAllows() {
      return resource.data.get('audiences', []).hasAny(readerAud());
    }

    // The published-and-in-audience predicate every global content read uses.
    // isAdmin() is OR'd in by callers so admins keep seeing drafts and
    // unpublished content.
    function contentReadable() {
      return resource != null
        && resource.data.get('status', 'draft') == 'published'
        && audienceAllows();
    }

    // Live economy config (system/economy), with a sane fallback if it's
    // somehow missing - used to bound coin-reward deltas below to whatever
    // the admin has actually configured, instead of a value baked into rules.
    function economyVal(field, fallback) {
      return exists(/databases/$(database)/documents/system/economy)
        ? get(/databases/$(database)/documents/system/economy).data.get(field, fallback)
        : fallback;
    }

    // DeVert Campus - Principal/HOD/Faculty-Class-Teacher hierarchy.
    // institutions/{id}/roleAssignments/{uid} is a SEPARATE collection from
    // admins/{uid} below (see that collection's own write rule - isAdmin()-
    // only, no client write path at all, since every account here is
    // created/managed exclusively by devert-backend's AdminAccountService).
    // Keeping it separate means a narrowly-scoped HOD/Faculty role can never
    // accidentally inherit isInstitutionAdmin()'s blanket rights just by
    // existing, the way it would if this lived inside admins/{uid} (which
    // grants full institution rights at ~20+ call sites throughout this
    // file). `status == 'active'` here is what makes disabling an account
    // (AdminAccountService's setStatus) take effect immediately, even
    // mid-session, not just on that account's next sign-in.
    function hasRoleAssignment(institutionId, uid) {
      return institutionId != '' && isAuth()
        && exists(/databases/$(database)/documents/institutions/$(institutionId)/roleAssignments/$(uid))
        && get(/databases/$(database)/documents/institutions/$(institutionId)/roleAssignments/$(uid)).data.status == 'active';
    }
    function myRoleAssignment(institutionId, uid) {
      return get(/databases/$(database)/documents/institutions/$(institutionId)/roleAssignments/$(uid)).data;
    }
    // Principal has identical breadth to an Institution Admin - folded
    // directly into isInstitutionAdmin() below as one more disjunct, so
    // every one of that function's ~20 existing call sites (contests,
    // dailyLearning, classrooms, settings, students, questionBank...) covers
    // Principal too with zero edits. HOD/Faculty get their own much
    // narrower helpers instead (isHodOfDepartment/isFacultyOfClassroom
    // below) - added only at the specific new call sites that need them,
    // never folded into this blanket check.
    function isPrincipal(institutionId) {
      return hasRoleAssignment(institutionId, request.auth.uid)
        && myRoleAssignment(institutionId, request.auth.uid).roleKey == 'principal';
    }

    // DeVert Campus - institution-scoped roles, checked the same way as isAdmin()
    // but against a Firestore membership doc instead of a custom claim (claims are
    // a single global flag on this project - not tenant-scoped, so institution
    // admins can't reuse that mechanism). See institutions/{institutionId} below.
    // institutionId != '' guards against a malformed institutions//admins/{uid}
    // path (Firestore throws an evaluation error, not a clean false, for an
    // empty path segment) - removeStudentFromInstitution's users/{uid} write
    // clears institutionId to '' as part of ending membership, and the
    // users/{uid} rule below calls isInstitutionAdmin(request.resource.data.institutionId)
    // on whatever value is being written, so this must fail closed on empty
    // input rather than crash the whole write.
    function isInstitutionAdmin(institutionId) {
      return institutionId != '' && isAuth() && (
        exists(/databases/$(database)/documents/institutions/$(institutionId)/admins/$(request.auth.uid))
        || isPrincipal(institutionId)
      );
    }
    function isApprovedStudent(institutionId) {
      return isAuth() && exists(/databases/$(database)/documents/institutions/$(institutionId)/students/$(request.auth.uid))
        && get(/databases/$(database)/documents/institutions/$(institutionId)/students/$(request.auth.uid)).data.status == 'approved';
    }

    // HOD/Faculty-Class-Teacher - narrow, single-scope counterparts to
    // isPrincipal() above. Unlike Principal, these are NEVER folded into
    // isInstitutionAdmin() - they only ever appear as their own additional
    // disjunct at the specific rules that need department/classroom
    // scoping (students/{uid}, classrooms/{classroomId}, dailyLearning/
    // {itemId} below, plus the isHodOfStudent/isFacultyOfStudent read-only
    // variants next to isAdminOfStudent further down), so a department- or
    // classroom-scoped role can never accidentally reach anything outside
    // its own scope through some OTHER call site that only meant to grant
    // full institution admins access.
    function isHodOfDepartment(institutionId, department) {
      return department != '' && hasRoleAssignment(institutionId, request.auth.uid)
        && myRoleAssignment(institutionId, request.auth.uid).roleKey == 'hod'
        && myRoleAssignment(institutionId, request.auth.uid).scope.get('department', '') == department;
    }
    function isFacultyOfClassroom(institutionId, classroomId) {
      return classroomId != '' && hasRoleAssignment(institutionId, request.auth.uid)
        && myRoleAssignment(institutionId, request.auth.uid).roleKey == 'facultyClassTeacher'
        && myRoleAssignment(institutionId, request.auth.uid).scope.get('classroomId', '') == classroomId;
    }

    // Same fallback shape as economyVal() above - system/rolePermissionDefaults
    // (seeded by scripts/seed-role-permission-defaults.mjs, mirrored in
    // devert-frontend/lib/permissions.js) holds each role's default granted
    // permissions; a missing doc fails to `false` (nothing granted) rather
    // than throwing, so a not-yet-seeded permission never accidentally opens
    // a write up.
    function rolePermissionDefault(roleKey, key) {
      return exists(/databases/$(database)/documents/system/rolePermissionDefaults)
        ? get(/databases/$(database)/documents/system/rolePermissionDefaults).data.get(roleKey, {}).get(key, false)
        : false;
    }
    // Effective permission = this admin's own explicit override if present,
    // else their role's configured default - "new role = configuration, not
    // redesign": a future role needs one new key in system/
    // rolePermissionDefaults, nothing here. Deliberately layered onto only
    // the specific mutating actions/reads named in the spec (see each call
    // site's own comment), not retrofitted onto every institution-scoped
    // rule in this file - scope (department/classroom) match is the real
    // security boundary these roles need; a missing hasPermission() grant
    // just means the client hides the control (lib/campusPermissions.js),
    // not a second security boundary layered onto every single field.
    function hasPermission(institutionId, uid, key) {
      return hasRoleAssignment(institutionId, uid)
        && myRoleAssignment(institutionId, uid).get('permissionOverrides', {})
             .get(key, rolePermissionDefault(myRoleAssignment(institutionId, uid).roleKey, key));
    }

    // Resolves which institution (if any) a student uid belongs to, purely
    // from the denormalized users/{uid}.institutionId field. Returns '' (never
    // matches a real institutionId, so isInstitutionAdmin('') is false) if the
    // user doc doesn't exist - fails closed, not open.
    function studentInstitutionId(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        ? get(/databases/$(database)/documents/users/$(uid)).data.get('institutionId', '')
        : '';
    }
    // Lets a campus admin be granted READ (never write) access to one
    // student's per-user docs in collections that are global, not nested
    // under institutions/{id} (Programming/CS Core progress, CodeLab progress
    // and submissions, Company Prep progress) for the Student Analytics
    // Dashboard. Deliberately does NOT trust studentInstitutionId(uid) alone -
    // users/{uid}.institutionId is writable by ANY institution admin (see
    // that match block's institution-admin branch), with no check there that
    // a real approved roster entry backs it, so trusting it here alone would
    // let an institution admin self-grant read access to an arbitrary
    // uninvolved user's progress by simply writing that user's own
    // institutionId to their own institution. Requiring the actual
    // institutions/{institutionId}/students/{uid} doc to exist AND still be on
    // the roster (approved OR suspended - same "still admin-manageable, just
    // not currently active" scope as fetchRosterStudents in lib/institutions.js;
    // a suspended student's whole point is staying reviewable so the admin can
    // decide whether to reactivate, so the Student Analytics Dashboard must
    // still work for them) closes that gap: the only way this doc exists in
    // one of those two states is through approveStudent()/suspendStudent()/
    // bulkAssignByRollNumber(), which are themselves already
    // institution-admin-gated writes tied to a real self-submitted join
    // request - 'pending'/'rejected' students, and removed ones (no doc at
    // all), don't qualify.
    function isAdminOfStudent(uid) {
      return studentInstitutionId(uid) != ''
        && isInstitutionAdmin(studentInstitutionId(uid))
        && exists(/databases/$(database)/documents/institutions/$(studentInstitutionId(uid))/students/$(uid))
        && get(/databases/$(database)/documents/institutions/$(studentInstitutionId(uid))/students/$(uid)).data.status in ['approved', 'suspended'];
    }
    // Mirror of isAdminOfStudent() above, for the two new narrower roles -
    // same exploit guard (a fabricated roster relationship alone is never
    // enough; the roster doc must genuinely exist in approved/suspended
    // state) and same read-only intent (Student Analytics Dashboard access),
    // just scoped to one department/classroom instead of the whole
    // institution. Added as additional disjuncts alongside every existing
    // isAdminOfStudent() call site below, never a replacement for it.
    function isHodOfStudent(uid) {
      return studentInstitutionId(uid) != ''
        && exists(/databases/$(database)/documents/institutions/$(studentInstitutionId(uid))/students/$(uid))
        && get(/databases/$(database)/documents/institutions/$(studentInstitutionId(uid))/students/$(uid)).data.status in ['approved', 'suspended']
        && isHodOfDepartment(studentInstitutionId(uid), get(/databases/$(database)/documents/institutions/$(studentInstitutionId(uid))/students/$(uid)).data.get('department', ''));
    }
    function isFacultyOfStudent(uid) {
      return studentInstitutionId(uid) != ''
        && exists(/databases/$(database)/documents/institutions/$(studentInstitutionId(uid))/students/$(uid))
        && get(/databases/$(database)/documents/institutions/$(studentInstitutionId(uid))/students/$(uid)).data.status in ['approved', 'suspended']
        && isFacultyOfClassroom(studentInstitutionId(uid), get(/databases/$(database)/documents/institutions/$(studentInstitutionId(uid))/students/$(uid)).data.get('classroomId', ''));
    }

    // Classroom-level module access (Manage -> a module's own tab -> Manage
    // Access - see lib/institutions.js's MODULES/isModuleEnabledForClassroom).
    // Fails OPEN (enabled) whenever there's nothing to scope against - no
    // classroomId on the user's profile, or the classroom doc doesn't exist -
    // matching the client's own default ("no data to scope" -> allowed), not
    // a stricter server-side default. Only enforced here for modules whose
    // write path is a real, institution-scoped client Firestore write
    // (Contests, Daily Learning) - Programming/CS Core/DSA/Company Vault are
    // global, publicly-readable catalogs with no institution-level read gate
    // at all today (see programmingLanguages/csCoreSubjects/problems/companies
    // above), so classroom access for those four is a navigation-level
    // control in the client, not a new content boundary to enforce here.
    function myClassroomId(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        ? get(/databases/$(database)/documents/users/$(uid)).data.get('classroomId', '')
        : '';
    }
    function isModuleEnabledForUser(uid, institutionId, moduleKey) {
      return myClassroomId(uid) == ''
        || !exists(/databases/$(database)/documents/institutions/$(institutionId)/classrooms/$(myClassroomId(uid)))
        || get(/databases/$(database)/documents/institutions/$(institutionId)/classrooms/$(myClassroomId(uid))).data.get('moduleAccess', {}).get(moduleKey, true) != false;
    }

    // Campus Entry's canonical academic fields - must exactly mirror
    // DEPARTMENTS/YEARS in lib/institutions.js (no shared source between a
    // rules file and client JS is possible, same manual-sync constraint the
    // CAMPUS_BRANDING_FIELDS allow-list already lives with elsewhere in this
    // file). Section isn't an enum - just one uppercase letter.
    function isValidDepartment(v) {
      return v in ['CSE(AI&ML)', 'CSE(DS)', 'CSE(CS)', 'CSE', 'CSE(IT)', 'MECH', 'AERO', 'ECE', 'EEE', 'CIVIL'];
    }
    function isValidYear(v) {
      return v in ['I Year', 'II Year', 'III Year', 'IV Year'];
    }

    // Institution-scoped contests (see contests/{contestId} below) are plain
    // contest docs with an institutionId field - these read that field via a
    // fresh get() (can't use `resource` from inside a nested subcollection
    // match, e.g. questions/answerKeys) to find which institution, if any,
    // owns a given contest, then defer to isInstitutionAdmin() above.
    function contestInstitutionId(contestId) {
      return get(/databases/$(database)/documents/contests/$(contestId)).data.get('institutionId', '');
    }
    function isContestInstitutionAdmin(contestId) {
      return contestInstitutionId(contestId) != '' && isInstitutionAdmin(contestInstitutionId(contestId));
    }
    // True for every global (no institutionId) contest, unconditionally -
    // matches today's open behavior for the public Arena. For an
    // institution-scoped contest, true only for that institution's own
    // approved students - the read/write branches below that gate on "any
    // signed-in user" (answerKeys/submissions post-contestEnd, registering)
    // must all pass through this, or a private college contest's questions,
    // answer keys, and other students' scores end up readable by anyone
    // with a DeVert account, not just that college's own approved roster.
    // A narrower punishment than suspendStudent() (which blocks the whole
    // workspace) - a student flagged contestRestricted (e.g. for cheating in
    // a contest) keeps daily learning/DSA/company vault access but can't
    // register for or read any more contests at that institution.
    function isContestRestricted(institutionId) {
      return isAuth() && exists(/databases/$(database)/documents/institutions/$(institutionId)/students/$(request.auth.uid))
        && get(/databases/$(database)/documents/institutions/$(institutionId)/students/$(request.auth.uid)).data.get('contestRestricted', false) == true;
    }
    // Server-side mirror of matchesTargetScope() in lib/contests.js - keep
    // both in exact sync. `scope` is a contest's whole targetScope map;
    // hierarchical filters (departments/years/sections/classroomIds) AND
    // together when more than one is populated, `uids` ORs on top of that
    // when both are set or is the sole gate when it's the only filter set,
    // and a "scoped" contest with every filter left empty fails OPEN
    // (matches everyone) - same "admin toggled Specific Audience but hasn't
    // picked anything yet" default as the client. Takes institutionId + uid
    // directly (not a contestId) so both the contest doc's own list()-safe
    // inline read rule below (which already has resource.data, no spare
    // get() needed) and isInContestAudience() right after this (which does
    // have a contestId to spare) can share one implementation.
    function contestScopeHasHierarchy(scope) {
      return scope.get('departments', []).size() > 0 || scope.get('years', []).size() > 0
        || scope.get('sections', []).size() > 0 || scope.get('classroomIds', []).size() > 0;
    }
    function contestScopeHierarchyMatches(scope, institutionId, uid) {
      return exists(/databases/$(database)/documents/institutions/$(institutionId)/students/$(uid))
        && (scope.get('departments', []).size() == 0
          || get(/databases/$(database)/documents/institutions/$(institutionId)/students/$(uid)).data.get('department', '') in scope.get('departments', []))
        && (scope.get('years', []).size() == 0
          || get(/databases/$(database)/documents/institutions/$(institutionId)/students/$(uid)).data.get('year', '') in scope.get('years', []))
        && (scope.get('sections', []).size() == 0
          || get(/databases/$(database)/documents/institutions/$(institutionId)/students/$(uid)).data.get('section', '') in scope.get('sections', []))
        && (scope.get('classroomIds', []).size() == 0
          || get(/databases/$(database)/documents/institutions/$(institutionId)/students/$(uid)).data.get('classroomId', '') in scope.get('classroomIds', []));
    }
    function matchesContestScope(scope, institutionId, uid) {
      return scope.get('mode', 'all') != 'scoped'
        || !(contestScopeHasHierarchy(scope) || scope.get('uids', []).size() > 0)
        || (contestScopeHasHierarchy(scope) && scope.get('uids', []).size() > 0
          ? (contestScopeHierarchyMatches(scope, institutionId, uid) || uid in scope.get('uids', []))
          : (contestScopeHasHierarchy(scope)
            ? contestScopeHierarchyMatches(scope, institutionId, uid)
            : uid in scope.get('uids', [])));
    }
    // contestId-based convenience wrapper - re-fetches the contest doc (cheap;
    // Firestore rules cache repeated get()s to the same path within one
    // evaluation, same trade-off contestInstitutionId()/isContestInstitutionAdmin()
    // already make) so every subcollection rule below can pass just a
    // contestId instead of threading targetScope/institutionId through.
    function isInContestAudience(contestId, uid) {
      return matchesContestScope(
        get(/databases/$(database)/documents/contests/$(contestId)).data.get('targetScope', {}),
        contestInstitutionId(contestId), uid);
    }
    // Whether a contest's rankings are actually published. `rankingVisibility`
    // used to exist only in the component, as the condition deciding whether a
    // Leaderboard button rendered - so "hidden" hid the widget while the
    // submissions collection stayed readable by every in-audience student the
    // moment contestEnd passed. Anyone with devtools could still read every
    // classmate's score and timing. For a placement contest whose rankings are
    // deliberately withheld that is a real disclosure, so the setting is now a
    // read condition here rather than a UI preference.
    //
    // Defaults mirror CONTEST_SETTINGS_DEFAULTS exactly (leaderboardEnabled
    // true, rankingVisibility 'campus_only'), so a contest that has never had
    // its settings touched - which is all of them today - keeps behaving
    // exactly as it does now. Only an explicit 'hidden' or a disabled
    // leaderboard closes peer reads.
    function contestRankingsPublished(contestId) {
      return get(/databases/$(database)/documents/contests/$(contestId)).data.get('settings', {}).get('leaderboardEnabled', true) == true
        && get(/databases/$(database)/documents/contests/$(contestId)).data.get('settings', {}).get('rankingVisibility', 'campus_only') != 'hidden';
    }
    function isApprovedForContest(contestId) {
      return contestInstitutionId(contestId) == ''
        || (isApprovedStudent(contestInstitutionId(contestId)) && !isContestRestricted(contestInstitutionId(contestId))
          && isInContestAudience(contestId, request.auth.uid));
    }

    // A single write may never move a user's own XP or credits by more than
    // this in one shot - blocks "set xp/credits to 999999999" from devtools.
    // Doesn't stop a scripted loop of small increments; closing that fully
    // needs the reward logic moved server-side (blocked on Cloud Functions
    // billing for now). Raised from 500 to 2000 so a single large contest
    // prize (see contests/{id}/submissions grading below) can still be
    // credited in one write - keep ContestsPanel's prizeXp/prizeCoins inputs
    // clamped to this same cap in the admin UI.
    function selfWriteDeltaSane(field) {
      return !(field in request.resource.data.diff(resource.data).affectedKeys())
        || (request.resource.data.get(field, 0) - resource.data.get(field, 0)) <= 2000;
    }

    // Score is the permanent academic-performance metric (separate from XP,
    // which is spendable/convertible - see lib/rewards.js) - it must NEVER
    // decrease from an owner write (no wallet operation, conversion, or
    // client bug can ever claw it back), on top of the same per-write delta
    // cap xp/credits already get.
    function selfScoreWriteSane(field) {
      return !(field in request.resource.data.diff(resource.data).affectedKeys())
        || (request.resource.data.get(field, 0) >= resource.data.get(field, 0)
          && (request.resource.data.get(field, 0) - resource.data.get(field, 0)) <= 2000);
    }

    // Same bounded-shared-counter shape as pulse_posts'/contests' own
    // engagement counters below - exactly one of these fields touched, by
    // exactly ±1 - so a liker/commenter/saver/viewer/sharer/repost-er can
    // credit someone ELSE's users/{uid} counter without being able to set it
    // (or several at once) to an arbitrary value.
    function boundedUserCounterWrite(field) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([field])
        && (request.resource.data.get(field, 0) - resource.data.get(field, 0)) in [-1, 0, 1];
    }

    // Users - public read (profiles are sharable); only owner/admin can write
    // Any auth user may update these specific aggregate counters only - each
    // is bumped by whoever performs the interaction (follow, like, comment,
    // save, share) on someone else's account/post, one field per write.
    match /users/{uid} {
      allow read:   if true;
      // Create-time validation - a bare isOwner(uid) let a first write to
      // this path set ANY value, including a forged xp/credits balance or a
      // self-assigned institution membership that never went through
      // approveStudent's workflow. Mirrors the update rule's own protections:
      // xp/credits must start at exactly 0 (matches AuthContext.js's real
      // creation payload), and none of the seven institution-membership
      // fields may be present at all - those only ever get set later via the
      // isInstitutionAdmin()-gated update branch below.
      allow create: if isOwner(uid)
        && request.resource.data.get('xp', 0) == 0
        && request.resource.data.get('credits', 0) == 0
        && !request.resource.data.keys().hasAny(
          ['institutionId', 'institutionSlug', 'department', 'year', 'section', 'rollNumber', 'campusFullName', 'classroomId']
        );
      // Campus membership fields (institutionId/institutionSlug/department/year/
      // section/rollNumber/campusFullName) are deliberately excluded from the
      // owner's normal profile-edit branch below - a student forging their own
      // institutionId would bypass the whole approval workflow in
      // institutions/{id}/students/{uid}, and rollNumber/campusFullName are the
      // Roll Number Lock's denormalized copies (see approveStudent /
      // updateStudentIdentity in lib/institutions.js) - only platform isAdmin()
      // or that specific institution's own admin (approving/reassigning this
      // student, or correcting their identity) may ever touch these seven
      // fields, and only all at once (never mixed with any other field).
      // Every quantity-like stat an owner can legitimately self-report (per
      // real call sites: contests.js's persistGrading writes contestXp/
      // contestCoins/contestsParticipated alongside xp/credits;
      // aptitude-section.jsx writes streak; shipyard writes ships; admin
      // revocation writes arenaWins) gets the SAME bounded-delta protection
      // xp/credits already had - closes the gap where an owner could smuggle
      // an unbounded write to any OTHER field through in the same write that
      // legitimately touches xp. problemsSolvedCount is deliberately
      // EXCLUDED from self-write entirely (not just delta-bounded): it has
      // no legitimate client write path at all - it's written only by
      // GradingService.java via the Admin SDK, which bypasses these rules -
      // so any owner write touching it is forged, full stop.
      allow update: if (isOwner(uid) && selfWriteDeltaSane('xp') && selfWriteDeltaSane('credits')
          && selfScoreWriteSane('score')
          && selfWriteDeltaSane('contestXp') && selfWriteDeltaSane('contestCoins')
          && selfWriteDeltaSane('contestsParticipated') && selfWriteDeltaSane('arenaWins')
          && selfWriteDeltaSane('streak') && selfWriteDeltaSane('ships')
          && !('problemsSolvedCount' in request.resource.data.diff(resource.data).affectedKeys())
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(
            ['institutionId', 'institutionSlug', 'department', 'year', 'section', 'rollNumber', 'campusFullName', 'classroomId']
          )) || isAdmin()
        || (isAuth() && (
          boundedUserCounterWrite('followersCount') || boundedUserCounterWrite('pulsePostsCount')
          || boundedUserCounterWrite('totalLikesReceived') || boundedUserCounterWrite('totalCommentsReceived')
          || boundedUserCounterWrite('totalSavesReceived') || boundedUserCounterWrite('totalSharesReceived')
          || boundedUserCounterWrite('totalViewsReceived') || boundedUserCounterWrite('totalRepostsReceived')
          || boundedUserCounterWrite('totalRepostsMade') || boundedUserCounterWrite('profileViews')
        ))
        // Checks isInstitutionAdmin against BOTH the new institutionId being
        // written AND the old one already on the doc - approveStudent needs
        // the former (new value "mrcet", old "" for a first-time approval),
        // but removeStudentFromInstitution needs the LATTER: it clears
        // institutionId to "", and isInstitutionAdmin("") is always false by
        // design (see that function), so without also checking the old value
        // a removal could never satisfy this branch at all - the admin doing
        // the removing administers the institution the student is LEAVING,
        // not any institution the (now blank) new value could name.
        // exists(institutions/{id}/students/{uid}) is required on top of
        // isInstitutionAdmin() - without it, ANY institution admin could
        // write these fields for a completely unrelated uid who never
        // joined their institution at all (users/{uid} is a single GLOBAL
        // collection, not path-scoped by institutionId like every other
        // campus rule, so isInstitutionAdmin() alone doesn't prove the
        // target uid has any real relationship to that institution).
        // Emulator-confirmed exploit this closed: an institution-A admin
        // rewriting a DIFFERENT institution's approved student's
        // institutionId to "A" (severing them from their real institution,
        // forging their academic identity), then adding them to institution
        // A's own roster to satisfy isAdminOfStudent() and read that
        // student's real coin/earnings/progress data - all with zero
        // consent and no real join-request ever happening. Requiring the
        // roster doc to already exist means the write can only ever be a
        // consequence of a genuine prior requestToJoin() (self-serve,
        // isOwner-only) or an existing membership being cleared - never a
        // fabricated relationship, since institutions/{id}/students/{uid}'s
        // own create rule no longer lets an admin conjure a roster doc for
        // an arbitrary uid either (see that rule).
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['institutionId', 'institutionSlug', 'department', 'year', 'section', 'rollNumber', 'campusFullName', 'classroomId']
        ) && (
          (isInstitutionAdmin(request.resource.data.institutionId)
            && exists(/databases/$(database)/documents/institutions/$(request.resource.data.institutionId)/students/$(uid)))
          || (isInstitutionAdmin(resource.data.get('institutionId', ''))
            && exists(/databases/$(database)/documents/institutions/$(resource.data.get('institutionId', ''))/students/$(uid)))
        ));
      allow delete: if isAdmin();
    }

    // Private user fields (currently just email) - split out of the publicly
    // readable users/{uid} doc, which grants `allow read: if true` for
    // sharable-profile reasons and was otherwise exposing email to every
    // visitor of a public Dev Card. Owner/admin only, both directions.
    match /users_private/{uid} {
      allow read: if isOwner(uid) || isAdmin() || isAdminOfStudent(uid) || isHodOfStudent(uid) || isFacultyOfStudent(uid);
      allow write: if isOwner(uid) || isAdmin();
    }

    // Follows - anyone can read; only follower can create/delete their own follow
    match /follows/{followId} {
      allow read:   if true;
      allow create: if isAuth() && request.resource.data.followerId == request.auth.uid;
      allow delete: if isAuth() && resource.data.followerId == request.auth.uid;
    }

    // Projects (Shipyard) - public read, owner writes
    match /projects/{projectId} {
      allow read:           if true;
      allow create:         if isAuth() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAuth() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // Missions - admin creates, public reads. Any signed-in user may bump
    // filled by exactly +1 when accepting a mission (no unaccept flow exists
    // in missions/page.jsx, so only the +1 direction is allowed) - same
    // bounded shared-counter pattern as contests/{contestId}.participantCount.
    match /missions/{missionId} {
      allow read:  if true;
      allow write: if isAdmin() || (isAuth()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['filled'])
        && (request.resource.data.get('filled', 0) - resource.data.get('filled', 0)) == 1);
    }

    // User missions - owner + admin
    match /user_missions/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
      match /progress/{missionId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
    }

    // Arena matches - a match session is created the moment a challenge is
    // picked (status "in_progress", server-stamped startedAt), then resolved
    // either by devert-backend's firebase-admin SDK after real grading
    // (status "won", bypasses these rules entirely - see codelab_submissions
    // below for the same pattern) or by the owner self-reporting a harmless
    // loss (0 XP either way, so forging your own forfeit/timeout buys
    // nothing). The client has NO legal path to status "won" or to touch
    // xp/testsPassed/etc - only the backend can write those.
    match /arena_matches/{matchId} {
      allow read:   if isAuth();
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'in_progress';
      allow update: if isAdmin()
        || (isAuth() && resource.data.uid == request.auth.uid
            && resource.data.status == 'in_progress'
            && request.resource.data.status in ['forfeit', 'timeout']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'finishedAt']));
    }

    // Grind log (daily problems per user)
    match /grind_log/{uid}/entries/{entryId} {
      allow read:  if isAuth();
      allow write: if isOwner(uid);
    }

    // Leaderboard - public read, admin writes
    match /leaderboard/{uid} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // Daily grind challenges - admin sets, authenticated users read
    match /dailyGrind/{dateId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // System config, feature flags, arena challenges, broadcast schedule, intel
    match /system/{document=**} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // Past broadcast episodes
    match /broadcasts/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // Platform changelog
    match /changelog/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // Intel - curated news articles
    match /intel_news/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // Intel - job opportunities
    match /intel_jobs/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // Intel - Opportunities feed (internships, certifications, hackathons,
    // scholarships, etc.) - global, admin-authored, same status-gated shape
    // as problems/programmingLanguages above. IMPORTANT: any client list()
    // query against this collection for non-admins MUST include a matching
    // where("status","==","published") filter - see lib/programming.js's
    // fetchLanguages comment for why an unfiltered query + client-side
    // filtering silently fails with permission-denied for every real user.
    match /opportunities/{oppId} {
      allow read:  if (resource != null && resource.data.get('status', 'draft') == 'published') || isAdmin();
      allow write: if isAdmin();
    }

    // Per-user saved/bookmarked opportunities - same shape as pulse_saves
    // (one doc per uid, a flat `saved` array of opportunity ids).
    match /opportunity_saves/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    // Hackathons - public read, admin writes
    match /hackathons/{slug} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // Hackathon registrations - public read, owner creates/deletes
    match /hackathon_registrations/{docId} {
      allow read:   if true;
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      // isAdmin() added - deleting a whole hackathon needs to clean up every
      // registration doc for it, not just let each student delete their own.
      allow delete: if isAdmin() || (isAuth() && resource.data.uid == request.auth.uid);
    }

    // Broadcast stream registrations - auth create own, read own
    match /stream_registrations/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuth() && resource.data.uid == request.auth.uid;
    }

    // Hackathon submissions - public read (winners.json / leaderboard). Owner
    // creates/edits their own submission CONTENT only, and only score/rank/
    // winner start null/false/null - once admin scores it (setting any of
    // those), the doc is locked from further owner edits. score/rank/winner
    // can only ever be admin-written, never forged by the owner themselves.
    match /hackathon_submissions/{docId} {
      allow read:   if true;
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid
        && request.resource.data.score == null
        && request.resource.data.winner == false
        && request.resource.data.rank == null;
      allow update: if isAdmin() || (
        isAuth() && resource.data.uid == request.auth.uid
        && resource.data.score == null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.score == null
        && request.resource.data.winner == false
        && request.resource.data.rank == null
      );
      allow delete: if isAdmin();
    }

    // Pulse posts - public read, any auth user can create (UGC).
    // Full-field edits are owner/admin only; any authenticated user may
    // update ONLY the engagement counters below - needed when liking,
    // commenting, saving, sharing, or viewing someone else's post. Each
    // such write may move exactly ONE of these fields by exactly ±1 - not
    // an arbitrary jump - so a single write can't fake a pile of engagement.
    match /pulse_posts/{postId} {
      allow read:   if true;
      // A new post must start with every engagement counter absent or zero -
      // otherwise a poster could forge a starting likeCount/commentCount/etc.
      // directly at creation, before the bounded ±1-per-write update rule
      // below ever gets a chance to apply.
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid
        && request.resource.data.get('likeCount', 0)    == 0
        && request.resource.data.get('commentCount', 0) == 0
        && request.resource.data.get('saveCount', 0)    == 0
        && request.resource.data.get('shareCount', 0)   == 0
        && request.resource.data.get('viewCount', 0)    == 0
        && request.resource.data.get('repostCount', 0)  == 0;
      allow update: if isAuth() && (
        resource.data.uid == request.auth.uid || isAdmin()
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['likeCount', 'commentCount', 'saveCount', 'shareCount', 'viewCount', 'repostCount']
          )
          && request.resource.data.diff(resource.data).affectedKeys().size() == 1
          && (request.resource.data.get('likeCount', 0)    - resource.data.get('likeCount', 0))    in [-1, 0, 1]
          && (request.resource.data.get('commentCount', 0) - resource.data.get('commentCount', 0)) in [-1, 0, 1]
          && (request.resource.data.get('saveCount', 0)    - resource.data.get('saveCount', 0))    in [-1, 0, 1]
          && (request.resource.data.get('shareCount', 0)   - resource.data.get('shareCount', 0))   in [-1, 0, 1]
          && (request.resource.data.get('viewCount', 0)    - resource.data.get('viewCount', 0))    in [-1, 0, 1]
          && (request.resource.data.get('repostCount', 0)  - resource.data.get('repostCount', 0))  in [-1, 0, 1]
        )
      );
      allow delete: if isAuth() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Pulse likes - public read, auth user manages their own like
    match /pulse_likes/{likeId} {
      allow read:   if true;
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuth() && resource.data.uid == request.auth.uid;
    }

    // Pulse reposts - public read, auth user manages their own repost
    match /pulse_reposts/{repostId} {
      allow read:   if true;
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuth() && resource.data.uid == request.auth.uid;
    }

    // Pulse comments - public read, auth user creates their own; owner/admin deletes
    match /pulse_comments/{commentId} {
      allow read:   if true;
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuth() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Pulse saves - owner reads/writes their own saves
    match /pulse_saves/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Reads either resource (an existing doc) or 0 - shared by user_earnings'
    // owner and non-owner branches below so both can express deltas the same way.
    function priorEarnings(field) {
      return resource == null ? 0 : resource.data.get(field, 0);
    }

    // User earnings - admin reads/writes freely. The owner is NOT a free-write
    // branch (a prior version let the owner set an arbitrary balance directly
    // from devtools, defeating the whole point of this bound) - they're held
    // to exactly two legitimate shapes:
    //   (a) XP -> coin conversion: pulseCoins and totalCoins increase together
    //       by the same amount, capped per write (coarse bound, not tied to
    //       the actual XP spent - rules can't see the sibling users/{uid}
    //       write in the same batch; a real fix needs the conversion moved
    //       server-side, blocked on Cloud Functions billing, same trade-off
    //       as selfWriteDeltaSane() above).
    //   (b) Payout withdrawal: pulseCoins may only DECREASE (reserved/spent
    //       at request time - see payout_requests below), never below 0;
    //       totalCoins (lifetime-earned) never moves.
    // Pulse engagement (likes/comments/saves) no longer grants coins at all
    // (platform policy: only Daily Learning, Programming, and CS Core
    // reward) - the non-owner PER_LIKE/PER_COMMENT/PER_SAVE crediting
    // disjunct that used to let a liker/commenter/saver's client credit the
    // POST AUTHOR's balance is removed. Only the owner branch remains (their
    // own reward grants from an allowed module, or spending via Wallet).
    match /user_earnings/{uid} {
      allow read:  if isOwner(uid) || isAdmin() || isAdminOfStudent(uid) || isHodOfStudent(uid) || isFacultyOfStudent(uid);
      allow create, update: if isAdmin() || (
        isOwner(uid)
        && request.resource.data.keys().hasOnly(['pulseCoins', 'totalCoins'])
        && request.resource.data.keys().size() == 2
        && request.resource.data.pulseCoins >= 0
        && (
          (
            (request.resource.data.pulseCoins - priorEarnings('pulseCoins')) == (request.resource.data.totalCoins - priorEarnings('totalCoins'))
            && (request.resource.data.pulseCoins - priorEarnings('pulseCoins')) > 0
            && (request.resource.data.pulseCoins - priorEarnings('pulseCoins')) <= 5000
          )
          || (
            request.resource.data.totalCoins == priorEarnings('totalCoins')
            && request.resource.data.pulseCoins <= priorEarnings('pulseCoins')
          )
        )
      );
    }

    // Payout requests - owner creates/reads own; admin manages all.
    // app/wallet/page.jsx's real flow bundles this create with a
    // user_earnings.pulseCoins decrement inside one runTransaction, but
    // rules evaluate each write independently - that client-side bundling is
    // a convention, not a boundary, so a direct addDoc() here bypassing the
    // decrement entirely would otherwise pass with any `coins` value. This
    // cross-document check requires the requested `coins` to never exceed
    // the requester's OWN real, current pulseCoins balance (read as of this
    // transaction's consistent snapshot, which for the legitimate flow above
    // is the pre-decrement balance - already >= coinAmt by the same
    // constraint the client itself enforces before writing).
    match /payout_requests/{requestId} {
      // isAdmin() is a genuinely separate top-level disjunct, not nested
      // inside isAuth() && (...) - Firestore's list-safety analysis denies
      // the WHOLE list() query otherwise (emulator-confirmed: a platform
      // admin's own Admin > Payouts panel - getDocs(query(collection(db,
      // "payout_requests"), orderBy(...))), no where clause - silently
      // returned zero results with this nested elsewhere in this file,
      // despite the admin genuinely satisfying isAdmin()). Same fix applied
      // to every other read rule below with this shape.
      allow read:           if isAdmin() || (isAuth() && resource.data.uid == request.auth.uid);
      allow create:         if isAuth() && request.resource.data.uid == request.auth.uid
        // status must start 'pending' - without this, a direct addDoc()
        // bypassing the Wallet page's UI could self-forge a request that
        // already reads as admin-approved (no review ever happened, and
        // it wouldn't even have the processedAt timestamp a real approval
        // sets, but nothing enforced the state machine at write time).
        && request.resource.data.status == 'pending'
        && request.resource.data.coins is number && request.resource.data.coins > 0
        && request.resource.data.coins <= (
          exists(/databases/$(database)/documents/user_earnings/$(request.auth.uid))
            ? get(/databases/$(database)/documents/user_earnings/$(request.auth.uid)).data.get('pulseCoins', 0)
            : 0
        );
      allow update, delete: if isAdmin();
    }

    // Intel resources - public read, admin writes
    match /intel_resources/{moduleId} {
      // NOT audience-gated, deliberately. This was `if true` and its consumers
      // (intel-app.jsx, admin/page.jsx) read it with a fully unfiltered
      // getDocs(collection(...)). Because Firestore's list authorisation is
      // analytical, a rule inspecting `audiences` would require every one of
      // those queries to constrain it - so gating 2 documents would break three
      // components for no benefit. The field is backfilled and ready if this ever
      // becomes real distribution.
      allow read:  if true;
      allow write: if isAdmin();
    }

    // Notifications - per-user targeted (targetUid), so reads are scoped to
    // the recipient or admin, not public - these can carry real INR payout
    // amounts and rejection reasons. 'all' is the one broadcast value meant
    // for every signed-in user (platform announcements) - broadcasts are
    // admin-only (payout/rejection/approval/promo are all genuinely
    // admin-triggered per their real call sites in app/admin/page.jsx and
    // lib/opportunities.js). A non-admin may only create an INDIVIDUAL
    // notification (never 'all'), self-attributed via `fromUid` (see
    // components/notification-bell.jsx's writeNotification, which stamps
    // this from auth.currentUser), and only for the real self-service event
    // types that actually fire this way (like/comment/follow/repost) - never
    // impersonating an admin-only type such as "payout"/"approval".
    match /notifications/{notifId} {
      // isAdmin() as a top-level disjunct, matching this file's established
      // convention elsewhere - directly emulator-verified this specific rule
      // (pure resource.data field comparisons, no nested get()/exists()
      // calls) does NOT actually exhibit the list()-breaking behavior seen
      // on isAdminOfStudent-style rules, so this is cheap defense-in-depth/
      // consistency, not a confirmed live bug fix.
      allow read: if isAdmin() || (isAuth() && (
        resource.data.targetUid == request.auth.uid
        || resource.data.targetUid == 'all'
      ));
      allow create: if isAdmin() || (
        isAuth()
        && request.resource.data.targetUid != 'all'
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.type in ['like', 'comment', 'follow', 'repost']
      );
      allow update, delete: if isAdmin();
    }

    // Admin audit trail - admin-only, both read and write
    match /admin_activity_log/{logId} {
      allow read, write: if isAdmin();
    }

    // Coin earning/spending ledger - written by whoever triggers the event
    // (may credit a different uid than the actor, e.g. a liker crediting
    // the post author), readable only by the owner or admin. Self-logged
    // entries (task rewards, XP conversion) are free-form since they only
    // ever affect the writer's own history; entries logged against SOMEONE
    // ELSE's uid must be a known received-engagement type at the matching
    // live rate, so a forged ledger entry can't misrepresent what happened.
    match /coin_transactions/{txId} {
      // isAdmin() as a separate top-level disjunct - see payout_requests
      // above for why nesting it inside isAuth() && (...) breaks list().
      allow read:   if isAdmin() || (isAuth() && (resource.data.uid == request.auth.uid || isAdminOfStudent(resource.data.uid) || isHodOfStudent(resource.data.uid) || isFacultyOfStudent(resource.data.uid)));
      allow create: if isAuth()
        && request.resource.data.amount is number
        && request.resource.data.type is string
        && (
          request.resource.data.uid == request.auth.uid
          || (request.resource.data.type == 'like_received'    && request.resource.data.amount == economyVal('PER_LIKE', 10))
          || (request.resource.data.type == 'comment_received' && request.resource.data.amount == economyVal('PER_COMMENT', 25))
          || (request.resource.data.type == 'save_received'    && request.resource.data.amount == economyVal('PER_SAVE', 15))
        );
    }

    // Central reward ledger (lib/rewards.js) - one immutable doc per
    // (uid, activityType, activityId), the single source of truth for "was
    // this specific reward already granted" across every module (Daily
    // Learning, Programming, CS Core, DSA, Contests, admin manual grants)
    // and the data source for the Student Analytics Dashboard's reward
    // timeline. Deliberately create-only from clients - this is the real
    // trust-boundary backstop: even if grantRewards()'s own app-level
    // idempotency check somewhere has a bug and fires twice for the same
    // (uid, activityType, activityId), the SECOND attempt is a write against
    // a doc that already exists, which Firestore classifies as an `update`,
    // not a `create` - rejected outright since only `create` is allowed here.
    // Reversal (duplicate-cleanup / conversion-reversal migrations) only
    // ever happens via the Admin SDK in scripts/, which bypasses these rules
    // entirely - never via a client update, so no client update path exists
    // for the ordinary reward flow (isAdmin() keeps a manual-fix escape
    // hatch through the admin console, matching this file's convention
    // elsewhere of admin-can-always-fix, e.g. payout_requests below).
    match /reward_grants/{gid} {
      // gid.split('_')[0] establishes ownership from the DOC ID alone, not
      // resource.data - critical because isAlreadyGranted() (lib/rewards.js)
      // calls get() specifically to check whether a reward DOESN'T exist yet
      // (the common case, checked on every fresh activity). A non-existent
      // doc makes `resource` null, so any earlier version of this rule that
      // dereferenced resource.data.uid unconditionally would throw on that
      // read and deny it outright - breaking every first-time reward check
      // with a permission-denied error instead of a clean "not found". A
      // Firebase Auth uid never contains '_', so split('_')[0] safely
      // isolates it regardless of how many underscores follow in
      // activityType/activityId (unlike the create rule's gid check below,
      // which needs the exact full reassembly, not just the first token).
      // Both an owner check AND the original resource.data.uid check are
      // kept, in this exact order - list()-safety analysis (the query in
      // fetchRewardTimeline is where("uid","==",X)) only manages to prove
      // this whole rule safe when resource.data.uid == request.auth.uid
      // appears as its own branch correlated with that query's field filter;
      // replacing it outright with the path-based check (however logically
      // equivalent for get()) broke that correlation and made the list()
      // safety prover choke on the later isAdminOfStudent branch instead
      // (verified empirically against the emulator, not assumed). Placing
      // gid.split('_')[0] FIRST is what actually fixes the reported bug: for
      // an owner's get() on a NOT-YET-existing doc (isAlreadyGranted()'s
      // core case), this branch alone evaluates true and short-circuits the
      // `||` before ever reaching resource.data.uid on a null resource.
      allow read: if isAdmin()
        || (isAuth() && gid.split('_')[0] == request.auth.uid)
        || (isAuth() && resource.data.uid == request.auth.uid)
        || isAdminOfStudent(resource.data.uid) || isHodOfStudent(resource.data.uid) || isFacultyOfStudent(resource.data.uid);
      // gid must equal rewardLedgerId(uid, activityType, activityId) exactly
      // (string concatenation, not a split - activityType/activityId can
      // themselves contain underscores, e.g. "daily_learning_problem" or
      // "{slug}_{date}_{problemId}", so splitting on '_' would misparse) -
      // without this, the create rule only bounded the CLAIMED xp/coins/
      // score to <=2000 with no check that gid corresponds to the payload's
      // own activityType/activityId at all, letting a student create a doc
      // under any gid shape they like.
      allow create: if isAdmin() || (
        isOwner(request.resource.data.uid)
        && gid == request.auth.uid + '_' + request.resource.data.activityType + '_' + request.resource.data.activityId
        && request.resource.data.status == 'granted'
        && request.resource.data.get('xp', 0) is number && request.resource.data.get('xp', 0) >= 0 && request.resource.data.get('xp', 0) <= 2000
        && request.resource.data.get('coins', 0) is number && request.resource.data.get('coins', 0) >= 0 && request.resource.data.get('coins', 0) <= 2000
        && request.resource.data.get('score', 0) is number && request.resource.data.get('score', 0) >= 0 && request.resource.data.get('score', 0) <= 2000
      );
      allow update, delete: if isAdmin();
    }

    // Learning ecosystem - Course -> Module -> Task(+Quiz) hierarchy.
    // Content is admin-authored, publicly readable; nested subcollections
    // inherit the same shape so new levels (module exams, etc.) slot in
    // without a rules rewrite.
    match /courses/{courseId} {
      // NOT audience-gated - same reasoning as intel_resources. today-task-card.jsx
      // reads this with an unfiltered getDocs(collection(db, "courses")), which an
      // audiences-inspecting rule would deny outright. One document; not worth it.
      allow read:  if true;
      allow write: if isAdmin();
      match /modules/{moduleId} {
        allow read:  if true;
        allow write: if isAdmin();
        match /tasks/{taskId} {
          allow read:  if true;
          allow write: if isAdmin();
        }
      }
    }

    // Per-user learning progress - owner or admin only.
    match /user_learning/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    // Aptitude & Reasoning - Topic -> Question bank, admin-authored, publicly
    // readable, no sequential unlock (unlike Learning tasks - any topic, any
    // order, unlimited re-attempts is the whole point of a practice bank).
    // Read gated on status (matching programmingLanguages/csCoreSubjects'
    // published-only-for-non-admin pattern) now that topics can carry a real
    // lesson-content layer (concept/keyPoints/mcqs/etc, see
    // AptitudeTopicsPanel) authored progressively as drafts - previously
    // unconditional `if true` leaked in-progress authoring to every visitor.
    // Every topic already created via the existing admin form is written
    // with status:"published" at creation time, so this is a no-op for
    // existing content - see lib/aptitude.js's fetchAptitudeTopics for the
    // matching required query-side where("status",...) filter.
    match /aptitude_topics/{topicId} {
      allow read:  if (resource.data.get('status', 'draft') == 'published' && audienceAllows()) || isAdmin();
      allow write: if isAdmin();
      match /questions/{questionId} {
        allow read: if true;
        // Admins can write any field. A signed-in student's client may ALSO
        // bump the three global stat counters (solved-by / accuracy / avg
        // time), one attempt's worth per write, same bounded-delta shape as
        // the missions `filled` counter below - not cheat-proof (a scripted
        // loop of legal small writes could still inflate these; closing that
        // needs a Cloud Function, which this project doesn't have yet), but
        // it keeps every content field (question/options/correctIndex/etc.)
        // admin-only.
        allow write: if isAdmin() || (isAuth()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['attemptCount', 'correctCount', 'totalTimeSec'])
          && (request.resource.data.get('attemptCount', 0) - resource.data.get('attemptCount', 0)) == 1
          && (request.resource.data.get('correctCount', 0) - resource.data.get('correctCount', 0)) in [0, 1]
          && (request.resource.data.get('totalTimeSec', 0) - resource.data.get('totalTimeSec', 0)) >= 0
          && (request.resource.data.get('totalTimeSec', 0) - resource.data.get('totalTimeSec', 0)) <= 3600);
      }
    }

    // Company Prep - Company -> Round -> Category -> Question, global
    // DeVert-authored content (same idea as aptitude_topics above, one level
    // deeper on each side: a company groups its own hiring rounds, each round
    // groups its own categories, since no two companies structure their
    // process the same way). A company doc gates every question underneath it
    // through a single 'status' field - draft companies (and everything
    // nested under them) are admin-only, published ones are public, exactly
    // like a contest's status gates its own questions/answerKeys.
    function isCompanyPublished(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)).data.get('status', '') == 'published';
    }
    match /companies/{companyId} {
      allow read:  if isAdmin() || (resource != null && resource.data.status == 'published' && audienceAllows());
      allow write: if isAdmin();

      match /rounds/{roundId} {
        allow read:  if isAdmin() || isCompanyPublished(companyId);
        allow write: if isAdmin();

        match /categories/{categoryId} {
          allow read:  if isAdmin() || isCompanyPublished(companyId);
          allow write: if isAdmin();

          match /questions/{questionId} {
            allow read: if isAdmin() || isCompanyPublished(companyId);
            // Same bounded-counter carve-out as aptitude_topics questions above -
            // admins write any field, a signed-in student's client may only ever
            // bump one attempt's worth onto the three global stat counters.
            allow write: if isAdmin() || (isAuth()
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['attemptCount', 'correctCount', 'totalTimeSec'])
              && (request.resource.data.get('attemptCount', 0) - resource.data.get('attemptCount', 0)) == 1
              && (request.resource.data.get('correctCount', 0) - resource.data.get('correctCount', 0)) in [0, 1]
              && (request.resource.data.get('totalTimeSec', 0) - resource.data.get('totalTimeSec', 0)) >= 0
              && (request.resource.data.get('totalTimeSec', 0) - resource.data.get('totalTimeSec', 0)) <= 3600);
          }
        }
      }

      // Admin-curated interview experiences (see lib/companyPrep.js's header
      // comment - genuine student submission is a real follow-up feature, not
      // built here) and admin-configured mock interviews (reference existing
      // round/category ids, pull their real questions live - see
      // fetchMockInterviewQuestions). Same read gate as rounds/categories,
      // write is admin-only for both - no student write path exists.
      match /interviewExperiences/{experienceId} {
        allow read:  if isAdmin() || isCompanyPublished(companyId);
        allow write: if isAdmin();
      }
      match /mockInterviews/{mockInterviewId} {
        allow read:  if isAdmin() || isCompanyPublished(companyId);
        allow write: if isAdmin();
      }
    }

    // Per-user aptitude practice progress - owner or admin only.
    // completedTopicIds.hasAll(...) makes the owner's own array monotonic -
    // once a topicId is in there, it can never be removed (only added to) -
    // same guard as programming_progress/cscore_progress, needed now that
    // completeAptitudeTopic (lib/aptitude.js) can grant XP/coins here:
    // without it, arrayRemove-ing a completed id and re-triggering
    // completion would re-earn that topic's reward indefinitely. Scoped to
    // only fire when completedTopicIds is actually present on the existing
    // doc, so the pre-existing attempted/topicStats/bookmarks-only writes
    // (which never touch this field) are completely unaffected.
    match /user_aptitude_progress/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin() || (isOwner(uid)
        && (resource == null || !('completedTopicIds' in resource.data) || request.resource.data.get('completedTopicIds', []).hasAll(resource.data.completedTopicIds)));
    }

    // Contest Platform - scheduled, ranked, multi-question events. Admin-authored,
    // publicly readable once published. Questions hold NO correct-answer data (so a
    // participant can't read answers from the network tab mid-contest) - that lives in
    // the sibling answerKeys subcollection, gated to open only once the contest has
    // ended for everyone. Submissions are created immutably (raw answers only) during
    // the contest, then get exactly one bounded, irreversible grading update after
    // answerKeys unlock - client-computed and only coarsely bounded (can't exceed the
    // contest's own announced prize caps), not re-verified server-side, since rules
    // can't loop over question docs. Same accepted trust-boundary trade-off as the coin
    // economy (see economyVal()/selfWriteDeltaSane() above) - a real Cloud Function is the
    // future hardening step, not something solved here.
    //
    // DeVert Campus extension: a contest may optionally carry an institutionId. Absent
    // = today's global DeVert Arena contest, unaffected by anything below. Present =
    // visible only to that institution's own approved students/admins (never the
    // public), and that institution's own admin gets the exact same create/manage
    // rights isAdmin() has today, scoped to contests actually tagged with their
    // institution - see isContestInstitutionAdmin() above.
    match /contests/{contestId} {
      // isInstitutionAdmin(resource.data.get(...)) here, NOT
      // isContestInstitutionAdmin(contestId) - that helper re-fetches this
      // exact document via a fresh get() (needed for the questions/answerKeys
      // subcollections below, where `resource` isn't the parent contest), but
      // doing that against the SAME document already being evaluated breaks
      // list() queries outright (verified against the emulator - Manage ->
      // Contests' admin-facing fetchInstitutionContests(institutionId) query
      // errored for every institution admin, not just denied). resource.data
      // is already the document being evaluated - no extra read needed, and
      // it stays query-provable since institutionId is exactly what
      // fetchInstitutionContests already filters on.
      allow read: if isAdmin()
        || isInstitutionAdmin(resource.data.get('institutionId', ''))
        || (resource != null && resource.data.status == 'published'
          && (!('institutionId' in resource.data)
            || (isApprovedStudent(resource.data.institutionId)
              && matchesContestScope(resource.data.get('targetScope', {}), resource.data.institutionId, request.auth.uid))));
      allow create: if isAdmin()
        || (isAuth() && request.resource.data.get('institutionId', '') != ''
          && isInstitutionAdmin(request.resource.data.institutionId));
      allow delete: if isAdmin() || isContestInstitutionAdmin(contestId);
      // Institution admin may update their own institution's contest freely, but can't
      // reassign it to a different (or no) institution. Any signed-in user may still
      // bump participantCount by exactly +-1 (registering/unregistering) on ANY contest -
      // same bounded shared-counter pattern as pulse_posts counters.
      allow update: if isAdmin()
        || (isContestInstitutionAdmin(contestId)
          && request.resource.data.get('institutionId', '') == resource.data.get('institutionId', ''))
        || (isAuth() && isApprovedForContest(contestId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantCount'])
          && (request.resource.data.get('participantCount', 0) - resource.data.get('participantCount', 0)) in [-1, 1]);

      match /questions/{questionId} {
        allow read:  if isAdmin() || isContestInstitutionAdmin(contestId) || isApprovedForContest(contestId);
        allow write: if isAdmin() || isContestInstitutionAdmin(contestId);

        // Coding-question test cases - same trust split as problems/{id}'s own
        // sampleTests (world/contest-readable, needed to render + let a student
        // sanity-check their code) vs hiddenTests (admin-only, NEVER read by any
        // client path - devert-backend's ContestGradingService reads these via
        // the admin SDK, which bypasses these rules entirely).
        match /sampleTests/{testId} {
          allow read:  if isAdmin() || isContestInstitutionAdmin(contestId) || isApprovedForContest(contestId);
          allow write: if isAdmin() || isContestInstitutionAdmin(contestId);
        }
        match /hiddenTests/{testId} {
          allow read:  if isAdmin() || isContestInstitutionAdmin(contestId);
          allow write: if isAdmin() || isContestInstitutionAdmin(contestId);
        }
      }

      match /answerKeys/{questionId} {
        allow read: if isAdmin() || isContestInstitutionAdmin(contestId) || (isApprovedForContest(contestId) &&
          isAuth() && request.time > get(/databases/$(database)/documents/contests/$(contestId)).data.contestEnd);
        allow write: if isAdmin() || isContestInstitutionAdmin(contestId);
      }

      match /announcements/{announcementId} {
        allow read:  if isAdmin() || isContestInstitutionAdmin(contestId) || isApprovedForContest(contestId);
        allow write: if isAdmin() || isContestInstitutionAdmin(contestId);
      }

      // Owner reads/creates their own registration within the registration window;
      // admin (platform or that institution's own) can read all (registrations
      // viewer). Non-owner may bump the parent contest's participantCount by exactly
      // +1 as part of registering - same bounded shared-counter pattern used for
      // pulse_posts engagement counts.
      match /registrations/{uid} {
        allow read:   if isOwner(uid) || isAdmin() || isContestInstitutionAdmin(contestId);
        allow create: if isOwner(uid) && isApprovedForContest(contestId) && request.resource.data.registeredAt != null
          && request.time <= get(/databases/$(database)/documents/contests/$(contestId)).data.registrationEnd
          && (contestInstitutionId(contestId) == '' || isModuleEnabledForUser(uid, contestInstitutionId(contestId), 'contests'));
        allow delete: if isOwner(uid) || isAdmin();
      }

      // Owner creates their own submission once, with raw answers only (no score/grade
      // fields yet). The one legal follow-up is the owner flipping graded false->true
      // after contestEnd, with xpEarned/coinsEarned bounded to the contest's own prize
      // caps. Anyone signed in can read submissions once the contest has ended - that's
      // what powers the per-contest leaderboard; that institution's own admin can read
      // earlier too (for a live registrations/submissions view while it's running).
      // Staff dry runs - an admin taking the paper to verify it without
      // becoming a participant. Deliberately a SEPARATE collection from
      // submissions rather than a flag on it: every analytics read
      // (fetchLeaderboard, fetchMyRank's count aggregations, the dashboard's
      // averages) queries submissions, so keeping dry runs out of that
      // collection excludes them from all of it with no query or index change,
      // and with no risk of a rule here weakening the real submission path.
      //
      // Admin-only in every direction, and only for THIS contest's own
      // institution. A student can neither read a dry run (which contains a
      // full worked attempt) nor write one - `isOwner(uid)` is deliberately
      // absent from create, unlike submissions, because a dry run is not a
      // participation record and nobody should be able to mint one for
      // themselves. Unlike a real submission it is freely deletable and
      // re-writable: it is scratch data an admin should be able to redo.
      match /dryRuns/{uid} {
        allow read, write: if isAdmin() || isContestInstitutionAdmin(contestId);
      }

      match /submissions/{uid} {
        // Own submission, or an admin's, is always readable. A PEER's is only
        // readable once the contest has ended AND its rankings are actually
        // published - see contestRankingsPublished(). Without that last clause
        // "hidden rankings" only hid the button.
        allow read: if isOwner(uid) || isAdmin() || isContestInstitutionAdmin(contestId) || (isApprovedForContest(contestId) &&
          isAuth() && request.time > get(/databases/$(database)/documents/contests/$(contestId)).data.contestEnd
          && contestRankingsPublished(contestId));
        // maxScore must be written honestly (client-computed from the real,
        // public question set) at create time and is then locked - the
        // grading update below bounds score/correctCount against it, so a
        // forged score can't blow past what the contest could ever award.
        // (maxScore itself is only a coarse sanity cap, not independently
        // re-verified - rules can't loop over question docs to sum marks;
        // real verification needs a Cloud Function, same trade-off as the
        // xpEarned/coinsEarned prize caps below.)
        allow create: if isOwner(uid) && isApprovedForContest(contestId)
          && request.resource.data.graded == false
          && !('score' in request.resource.data)
          && !('xpEarned' in request.resource.data)
          && !('coinsEarned' in request.resource.data)
          && request.resource.data.maxScore is number
          && request.resource.data.maxScore > 0
          && request.resource.data.maxScore <= 1000;
        // isOwner OR that institution's admin. Grading only ever ran in the
        // student's own browser, the first time they reopened their result -
        // so a student who submitted and closed the tab was never graded, sat
        // in no leaderboard, and was silently excluded from the average /
        // highest / lowest, which are computed over graded submissions only.
        // Every headline number was therefore drawn from the students engaged
        // enough to come back. With grading locked to isOwner there was no
        // remedy: the admin running the contest could not score it either.
        //
        // The admin is bound by EXACTLY the same clauses as the student below -
        // same affectedKeys allowlist, same score/accuracy/correctCount bounds
        // against the locked maxScore, same after-contestEnd requirement, and
        // still only on a submission that is not yet graded. This widens WHO
        // may grade, never WHAT a grading write is allowed to say.
        allow update: if (isOwner(uid) || isContestInstitutionAdmin(contestId) || isAdmin())
          && resource.data.graded == false
          && request.resource.data.graded == true
          && request.time > get(/databases/$(database)/documents/contests/$(contestId)).data.contestEnd
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['graded', 'score', 'accuracy', 'correctCount', 'xpEarned', 'coinsEarned']
          )
          && request.resource.data.score >= 0
          && request.resource.data.score <= resource.data.maxScore
          && request.resource.data.accuracy >= 0
          && request.resource.data.accuracy <= 100
          && request.resource.data.correctCount >= 0
          && request.resource.data.correctCount <= resource.data.maxScore
          // .get(field, 0), NOT dot access. Dot-accessing a key absent from the
          // resulting document THROWS in rules, denying the whole expression -
          // and xpEarned/coinsEarned are absent from every real grading write:
          // the create rule above explicitly forbids them, and persistGrading
          // writes only graded/score/accuracy/correctCount, because contests
          // deliberately grant no XP or coins any more. So these two clauses
          // denied EVERY grading attempt, by students and admins alike, with
          // "Property xpEarned is undefined". Caught by the admin-sweep
          // emulator test failing on a perfectly well-formed write.
          //
          // The caps are kept rather than dropped: if a contest ever does award
          // a prize and writes these fields, they stay bounded by its own
          // prizeXp/prizeCoins.
          && request.resource.data.get('xpEarned', 0) >= 0
          && request.resource.data.get('xpEarned', 0) <= get(/databases/$(database)/documents/contests/$(contestId)).data.get('prizeXp', 0)
          && request.resource.data.get('coinsEarned', 0) >= 0
          && request.resource.data.get('coinsEarned', 0) <= get(/databases/$(database)/documents/contests/$(contestId)).data.get('prizeCoins', 0);
        // "Reset attempt" (Student Management) - deleting the submission doc
        // lets the student attempt the contest again; only that institution's
        // own admin (or platform isAdmin()) can do this.
        allow delete: if isContestInstitutionAdmin(contestId) || isAdmin();

        // Per-question coding-question results - written ONLY by
        // devert-backend's ContestGradingService via the admin SDK (bypasses
        // these rules entirely, allow write: false is real here, not just a
        // client-side nicety), since an honest score can only ever come from
        // actually running the hidden tests server-side. Deliberately its own
        // subcollection rather than a field on this submission doc - see
        // lib/contests.js's fetchContestCodingResults comment on why a
        // pre-submit write into the parent doc would break the create-vs-
        // update rule branch the final MCQ submit above depends on. Same read
        // visibility as the parent submission doc.
        match /codingResults/{questionId} {
          allow read: if isOwner(uid) || isAdmin() || isContestInstitutionAdmin(contestId) || (isApprovedForContest(contestId) &&
            isAuth() && request.time > get(/databases/$(database)/documents/contests/$(contestId)).data.contestEnd);
          allow write: if false;
        }
      }
    }

    // CodeLab - problems/playground platform. Problems and their sample tests are
    // world-readable (needed to render the problem statement); hidden tests are
    // admin-only and are NEVER read by any client code path - unlike Contests' answer
    // keys (which unlock after a contestEnd timestamp), problems are evergreen with no
    // "end time" to gate behind, so hidden tests can only ever be read server-side, by
    // devert-backend's firebase-admin SDK (which bypasses these rules entirely). Grading
    // happens the same way: codelab_submissions is owner/admin READ-only from the
    // client - every write is performed by the trusted backend after running the
    // hidden tests itself, so there's no bounded-trust compromise to make here.
    match /problems/{problemId} {
      allow read:  if (resource != null && resource.data.status == 'published') || isAdmin();
      allow write: if isAdmin();

      match /sampleTests/{testId} {
        allow read:  if true;
        allow write: if isAdmin();
      }

      match /hiddenTests/{testId} {
        allow read:  if isAdmin();
        allow write: if isAdmin();
      }
    }

    match /codelab_submissions/{submissionId} {
      // isAdmin() as a separate top-level disjunct - see payout_requests
      // above for why nesting it inside isAuth() && (...) breaks list().
      allow read:  if isAdmin() || (isAuth() && (resource.data.uid == request.auth.uid || isAdminOfStudent(resource.data.uid) || isHodOfStudent(resource.data.uid) || isFacultyOfStudent(resource.data.uid)));
      allow write: if isAdmin();
    }

    // Per-user CodeLab progress - owner, platform admin, or that student's own
    // campus admin (read-only) may read; only the owner or a platform admin
    // may write. Written by devert-backend's admin SDK after each graded
    // submission; the owner-write path exists only so future client-side
    // preference writes (if any) have somewhere sane to land.
    match /user_codelab_progress/{uid} {
      allow read:  if isOwner(uid) || isAdmin() || isAdminOfStudent(uid) || isHodOfStudent(uid) || isFacultyOfStudent(uid);
      // solvedProblems is monotonic for the owner's own write - once a
      // problemId key is set, the owner can never remove it (only add more).
      // Without this, a student could delete their own solvedProblems.{id}
      // entry client-side, then resubmit already-accepted code; the backend's
      // grading transaction (GradingService.java) reads alreadySolved=false
      // and re-credits xp/score/coins/problemsSolvedCount indefinitely.
      allow write: if isAdmin() || (isOwner(uid)
        && (resource == null || !('solvedProblems' in resource.data)
            || resource.data.solvedProblems.keys().toSet()
                 .difference(request.resource.data.get('solvedProblems', {}).keys().toSet()).size() == 0));
    }

    // Per-student, per-problem DSA study metadata (favorite/bookmark/review-
    // later/needs-revision/confidence/personal rating/notes/tags/revision
    // schedule) - purely personal organization, never touches solvedProblems
    // or any reward/coin/XP field, so there's no economic bound to enforce
    // here (unlike reward_grants/user_earnings above). docId is
    // `${uid}_${problemId}`; a Firestore auto-generated problemId never
    // contains '_', so the full-string equality check below (same idiom as
    // reward_grants' gid check, stricter than dailyLearningLog's split()[0])
    // ties the doc ID itself to both the auth uid AND the payload's own uid/
    // problemId fields.
    //
    // The read rule's `resource.data.uid == request.auth.uid` disjunct looks
    // redundant with the docId split check right above it, but it is NOT:
    // Firestore's list()-safety static analyzer only skips evaluating a
    // later nested-get()-based branch (isAdminOfStudent here) when it can
    // prove every earlier branch is a plain field comparison correlated with
    // the query's own where("uid","==",...) filter. A path/doc-ID-derived
    // check alone doesn't give it that proof and the analyzer throws a "Null
    // value error" on list() even though every individual get() looked fine
    // in testing - this exact regression already happened once on
    // reward_grants (see above); the fix there was to ADD this field-based
    // branch back, not remove the docId one. Verified directly via a
    // uid-filtered list() query in test/firestore-rules.test.mjs, not assumed.
    match /problem_notes/{docId} {
      allow read: if isAdmin()
        || (isAuth() && docId.split('_')[0] == request.auth.uid)
        || (isAuth() && resource.data.uid == request.auth.uid)
        || isAdminOfStudent(resource.data.uid) || isHodOfStudent(resource.data.uid) || isFacultyOfStudent(resource.data.uid);
      allow write: if isAdmin() || (
        isAuth()
        && isOwner(request.resource.data.uid)
        && docId == request.auth.uid + '_' + request.resource.data.problemId
        && request.resource.data.get('notes', '') is string && request.resource.data.get('notes', '').size() <= 2000
        && request.resource.data.get('tags', []).size() <= 20
        && request.resource.data.get('personalRating', 0) is number
        && request.resource.data.get('personalRating', 0) >= 0 && request.resource.data.get('personalRating', 0) <= 5
      );
    }

    // One doc per (uid, date) - real activity/engagement tracking (see
    // lib/activity.js for why this is a daily rollup, not a raw event log).
    // Same owner-write/admin-or-campus-admin-read shape as the progress
    // collections above; docId is `${uid}_${date}` (date is YYYY-MM-DD, no
    // underscores in it), so split('_')[0] cleanly isolates uid the same way
    // programming_progress/cscore_progress already do.
    match /user_activity_daily/{activityId} {
      // isAdmin() as a separate top-level disjunct - see payout_requests
      // above for why nesting it inside isAuth() && (...) breaks list().
      allow read:  if isAdmin() || (isAuth() && (activityId.split('_')[0] == request.auth.uid || isAdminOfStudent(activityId.split('_')[0]) || isHodOfStudent(activityId.split('_')[0]) || isFacultyOfStudent(activityId.split('_')[0])));
      allow write: if isAuth() && activityId.split('_')[0] == request.auth.uid;
    }

    // Per-user Company Prep progress (solved/bookmarked question ids, flat
    // maps keyed by questionId - same shape as user_codelab_progress's
    // solvedProblems) - same owner/platform-admin/campus-admin-read shape.
    match /user_companyPrep/{uid} {
      allow read:  if isOwner(uid) || isAdmin() || isAdminOfStudent(uid) || isHodOfStudent(uid) || isFacultyOfStudent(uid);
      allow write: if isOwner(uid) || isAdmin();
    }

    // Programming module - a GLOBAL language/topic catalog (like problems/
    // companies above), not per-institution: a language's curriculum is the
    // same for every college, authored once by platform admins via /admin,
    // not each Training & Placement Cell. Published languages/topics are
    // publicly readable (including unauthenticated, matching the
    // problems/companies precedent); drafts are admin-only so in-progress
    // authoring never leaks.
    match /programmingLanguages/{langId} {
      allow read:  if contentReadable() || isAdmin();
      allow write: if isAdmin();

      match /topics/{topicId} {
        allow read:  if contentReadable() || isAdmin();
        allow write: if isAdmin();
      }
    }

    // Per-user Programming progress - one doc per (uid, langId), same
    // owner-writes-their-own-record trust boundary as user_codelab_progress/
    // dailyLearningLog: self-reported completion, bounded to this user's own
    // doc id, XP/coins awarded client-side the same way Daily Learning's
    // submitDayCompletion() already does (see lib/programming.js).
    match /programming_progress/{progressId} {
      // isAdmin() on read too - the discovery query deleteLanguage's own
      // cleanup needs to run (list every progress doc for a deleted global
      // language, across every institution) can't rely on isAdminOfStudent,
      // which only ever resolves true for that student's OWN institution
      // admin, not a platform admin managing global content.
      allow read:  if isAdmin() || (isAuth() && (progressId.split('_')[0] == request.auth.uid || isAdminOfStudent(progressId.split('_')[0]) || isHodOfStudent(progressId.split('_')[0]) || isFacultyOfStudent(progressId.split('_')[0])));
      // isAdmin() (not isAdminOfStudent) - a platform admin deleting a whole
      // language from Manage Programming needs to clean up every student's
      // progress doc for it, across every institution, not just their own.
      // completedTopicIds.hasAll(...) makes the owner's own array monotonic -
      // once a topicId is in there, the owner can never remove it (only add
      // more) - without this, arrayRemove-ing a completed id and re-triggering
      // completeTopic() re-earns that topic's reward indefinitely.
      allow write: if isAdmin() || (isAuth() && progressId.split('_')[0] == request.auth.uid
        && (resource == null || !('completedTopicIds' in resource.data) || request.resource.data.get('completedTopicIds', []).hasAll(resource.data.completedTopicIds)));
    }

    // CS Core - identical shape/authority to programmingLanguages above
    // (global, admin-authored subject/topic catalog - OS, DBMS, Networks,
    // etc. are the same for every institution, not per-campus content).
    match /csCoreSubjects/{subjectId} {
      allow read:  if contentReadable() || isAdmin();
      allow write: if isAdmin();

      match /topics/{topicId} {
        allow read:  if contentReadable() || isAdmin();
        allow write: if isAdmin();
      }
    }

    match /cscore_progress/{progressId} {
      // isAdmin() on read too - same reasoning as programming_progress above,
      // deleteSubject's own cleanup discovery query needs it.
      allow read:  if isAdmin() || (isAuth() && (progressId.split('_')[0] == request.auth.uid || isAdminOfStudent(progressId.split('_')[0]) || isHodOfStudent(progressId.split('_')[0]) || isFacultyOfStudent(progressId.split('_')[0])));
      // isAdmin() (not isAdminOfStudent) - same reasoning as
      // programming_progress above: deleting a whole subject needs to clean
      // up every student's progress doc for it, across every institution.
      // completedTopicIds.hasAll(...) - same monotonicity guard as
      // programming_progress, closing the identical reward-replay exploit.
      allow write: if isAdmin() || (isAuth() && progressId.split('_')[0] == request.auth.uid
        && (resource == null || !('completedTopicIds' in resource.data) || request.resource.data.get('completedTopicIds', []).hasAll(resource.data.completedTopicIds)));
    }

    // ── GATE preparation module ────────────────────────────────────────────────
    // A GLOBAL, admin-authored catalog three levels deep
    // (gatePapers/{paperId}/subjects/{subjectId}/topics/{topicId}) - same
    // authority shape as programmingLanguages/csCoreSubjects above, one level
    // deeper. The extra level is what lets a new GATE paper be added without a
    // schema change; see lib/gate.js's header.
    //
    // Published content is world-readable (matching the problems/companies/
    // programmingLanguages precedent), drafts are admin-only so in-progress
    // authoring never leaks. IMPORTANT: every non-admin list() against any of
    // these collections MUST carry a matching where("status","==","published")
    // filter - see lib/programming.js's fetchLanguages comment for why an
    // unfiltered query plus client-side filtering fails with permission-denied
    // for every real student rather than silently returning less.
    match /gatePapers/{paperId} {
      allow read:  if contentReadable() || isAdmin();
      allow write: if isAdmin();

      match /subjects/{subjectId} {
        allow read:  if contentReadable() || isAdmin();
        allow write: if isAdmin();

        match /topics/{topicId} {
          allow read:  if contentReadable() || isAdmin();
          allow write: if isAdmin();
        }
      }
    }

    // Previous-year questions are STUDY MATERIAL, so a published one carries its
    // full worked solution inline and is readable outright. That is the correct
    // boundary for this content and not an oversight: a student working through a
    // past paper topic by topic is meant to be able to check the solution, and
    // hiding it behind an attempt would make the bank worse at its job. The
    // timed, answers-hidden version of the same material is a gate_tests
    // document, which IS gated (see below). lib/gatePyq.js's header states the
    // same split.
    match /gate_pyqs/{pyqId} {
      allow read:  if (resource != null && resource.data.get('status', 'draft') == 'published') || isAdmin();
      allow write: if isAdmin();
    }

    // A test's questions carry NO answer data (see lib/gateTests.js's
    // buildQuestionDoc/buildAnswerKeyDoc split) - everything that would give the
    // answer away lives in the sibling answerKeys subcollection, gated below.
    function isGateTestPublished(testId) {
      return exists(/databases/$(database)/documents/gate_tests/$(testId))
        && get(/databases/$(database)/documents/gate_tests/$(testId)).data.get('status', 'draft') == 'published';
    }
    // "Has this user already submitted this test." The path is fully determined
    // by request.auth.uid and the {testId} wildcard - no reliance on
    // resource.data - which is exactly what makes it provable for a list() query
    // over the answerKeys collection, not just a single get(). A testId is a
    // Firestore auto-ID and never contains '_', so the concatenation below can't
    // be confused by a testId that looks like another uid's attempt.
    function hasSubmittedGateTest(testId) {
      return isAuth()
        && exists(/databases/$(database)/documents/gate_attempts/$(request.auth.uid + '_' + testId))
        && get(/databases/$(database)/documents/gate_attempts/$(request.auth.uid + '_' + testId)).data.get('submitted', false) == true;
    }

    match /gate_tests/{testId} {
      allow read:  if (resource != null && resource.data.get('status', 'draft') == 'published') || isAdmin();
      allow write: if isAdmin();

      match /questions/{questionId} {
        allow read:  if isAdmin() || isGateTestPublished(testId);
        allow write: if isAdmin();
      }

      // THE trust boundary of the testing engine: a student may read a test's
      // answer keys only AFTER their own attempt is marked submitted. Solutions
      // being unavailable mid-attempt is enforced here, in the database - not by
      // the interface choosing not to fetch them. That is why
      // lib/gateTests.js's submitAndGrade must write the submission BEFORE it
      // reads the keys, and why grading can honestly be done client-side at all.
      match /answerKeys/{questionId} {
        allow read:  if isAdmin() || hasSubmittedGateTest(testId);
        allow write: if isAdmin();
      }

      // An answer-free score summary per student, written in the same
      // transaction as the grading, existing purely so leaderboards are possible
      // without exposing attempt documents (which contain the student's actual
      // answers). Signed-in read is therefore safe: nothing here can reconstruct
      // an answer.
      //
      // Create-only for the owner, never update - the same one-shot shape
      // reward_grants uses. A second write is rejected as an update against an
      // existing document, so a score can't be revised upward after the fact.
      // score/maxScore are bounded as a coarse sanity cap the same way a contest
      // submission's are; rules cannot sum a test's marks to verify exactly
      // (that needs a Cloud Function - the same standing limitation documented
      // for the coin economy).
      match /results/{uid} {
        allow read: if isAuth();
        allow create: if isAdmin() || (isOwner(uid)
          && request.resource.data.uid == uid
          && request.resource.data.maxScore is number
          && request.resource.data.maxScore > 0
          && request.resource.data.maxScore <= 1000
          && request.resource.data.score is number
          && request.resource.data.score <= request.resource.data.maxScore
          && request.resource.data.get('accuracy', 0) is number
          && request.resource.data.get('accuracy', 0) >= 0
          && request.resource.data.get('accuracy', 0) <= 100
          && request.resource.data.get('timeTakenSeconds', 0) is number
          && request.resource.data.get('timeTakenSeconds', 0) >= 0
          // Display-only denormalized fields, size-capped so this can't be used
          // as free storage or to inject a wall of text into a leaderboard row.
          && request.resource.data.get('handle', '') is string && request.resource.data.get('handle', '').size() <= 64
          && request.resource.data.get('campusFullName', '') is string && request.resource.data.get('campusFullName', '').size() <= 128
          && request.resource.data.get('rollNumber', '') is string && request.resource.data.get('rollNumber', '').size() <= 64
          && request.resource.data.get('department', '') is string && request.resource.data.get('department', '').size() <= 128
          && request.resource.data.get('section', '') is string && request.resource.data.get('section', '').size() <= 32);
        allow update, delete: if isAdmin();
      }
    }

    match /gate_formulas/{formulaId} {
      allow read:  if (resource != null && resource.data.get('status', 'draft') == 'published') || isAdmin();
      allow write: if isAdmin();
    }
    match /gate_resources/{resourceId} {
      allow read:  if (resource != null && resource.data.get('status', 'draft') == 'published') || isAdmin();
      allow write: if isAdmin();
    }
    match /gate_announcements/{announcementId} {
      allow read:  if (resource != null && resource.data.get('status', 'draft') == 'published') || isAdmin();
      allow write: if isAdmin();
    }

    // Per-user GATE progress - one doc per (uid, paperId), id `${uid}_${paperId}`.
    // A paperId may contain a hyphen ("cs-da") but never an underscore, so
    // split('_')[0] cleanly isolates the uid, exactly as programming_progress
    // and cscore_progress already do.
    //
    // completedTopicIds.hasAll(...) makes the owner's own array monotonic: once
    // a topicId is in there the owner can never remove it, only add. Without
    // this, arrayRemove-ing a completed id and re-triggering completeTopic()
    // would re-earn that topic's XP/coins indefinitely - the identical
    // reward-replay exploit closed on the other two progress collections.
    // isAdmin() (not isAdminOfStudent) on write because deleting a whole
    // paper/subject must clean up every student's progress doc for it across
    // every institution (see lib/gate.js's deletePaper/scrubCompletedTopicIds).
    match /gate_progress/{progressId} {
      allow read:  if isAdmin() || (isAuth() && (progressId.split('_')[0] == request.auth.uid
        || isAdminOfStudent(progressId.split('_')[0]) || isHodOfStudent(progressId.split('_')[0]) || isFacultyOfStudent(progressId.split('_')[0])));
      allow write: if isAdmin() || (isAuth() && progressId.split('_')[0] == request.auth.uid
        && (resource == null || !('completedTopicIds' in resource.data) || request.resource.data.get('completedTopicIds', []).hasAll(resource.data.completedTopicIds)));
    }

    // Daily GATE plan - one doc per (uid, paperId, date), id
    // `${uid}_${paperId}_${date}`. Same self-reported-completion trust boundary
    // as dailyLearningLog.
    //
    // `rewarded` is one-way: once true it can never be set back to false. That
    // is the whole guard against replaying a day's XP/coins by un-ticking the
    // flag and calling completeDay() again. reward_grants' create-only ledger is
    // the second, independent backstop (activityId is `${paperId}_${date}`, so
    // a repeat grant for the same day is rejected there too).
    match /gate_daily/{dailyId} {
      allow read:  if isAdmin() || (isAuth() && (dailyId.split('_')[0] == request.auth.uid
        || isAdminOfStudent(dailyId.split('_')[0]) || isHodOfStudent(dailyId.split('_')[0]) || isFacultyOfStudent(dailyId.split('_')[0])));
      allow write: if isAdmin() || (isAuth() && dailyId.split('_')[0] == request.auth.uid
        && (resource == null || resource.data.get('rewarded', false) == false || request.resource.data.get('rewarded', false) == true));
    }

    // Test attempts contain the student's own answers, so they are OWNER-ONLY -
    // never readable by other students. Leaderboards read the answer-free
    // gate_tests/{testId}/results/{uid} summary instead.
    //
    // The read rule is FIELD-based (resource.data.uid), not doc-ID-derived,
    // because lib/gateTests.js's fetchMyAttempts is a real list() query filtered
    // on where("uid","==",uid) - and Firestore's list()-safety analyzer needs a
    // plain field comparison correlated with that filter to prove the query
    // safe. A path-derived check alone throws a "Null value error" on list();
    // this is the exact regression documented on reward_grants and problem_notes
    // above, and the fix is the same. Writes keep the stricter doc-ID check,
    // since every write is to a known id.
    //
    // `graded` is one-way and the grading write is bounded: a graded attempt can
    // never be un-graded and re-scored, and score can never exceed maxScore.
    // maxScore itself is written honestly at grading time from the real, readable
    // question set - a coarse cap rather than independent verification, the same
    // acknowledged trade-off as contest submissions above.
    match /gate_attempts/{attemptId} {
      allow read:  if isAdmin()
        || (isAuth() && resource.data.uid == request.auth.uid)
        || (isAuth() && attemptId.split('_')[0] == request.auth.uid)
        || isAdminOfStudent(resource.data.uid) || isHodOfStudent(resource.data.uid) || isFacultyOfStudent(resource.data.uid);
      allow create: if isAdmin() || (isAuth() && attemptId.split('_')[0] == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.get('submitted', false) == false
        && request.resource.data.get('graded', false) == false
        && !('score' in request.resource.data));
      allow update: if isAdmin() || (isAuth() && attemptId.split('_')[0] == request.auth.uid
        && resource.data.uid == request.auth.uid
        && resource.data.get('graded', false) == false
        && (!('score' in request.resource.data)
          || (request.resource.data.score is number
            && request.resource.data.maxScore is number
            && request.resource.data.maxScore > 0
            && request.resource.data.maxScore <= 1000
            && request.resource.data.score <= request.resource.data.maxScore)));
      allow delete: if isAdmin();
    }

    // Per-user PYQ practice history and per-topic accuracy rollups - id
    // `${uid}_${paperId}`, same shape as gate_progress. Nothing here is
    // reward-bearing (practice grants no XP/coins - only topic completion and
    // Daily GATE do), so there is no economic bound to enforce, only ownership.
    match /gate_pyq_progress/{progressId} {
      allow read:  if isAdmin() || (isAuth() && (progressId.split('_')[0] == request.auth.uid
        || isAdminOfStudent(progressId.split('_')[0]) || isHodOfStudent(progressId.split('_')[0]) || isFacultyOfStudent(progressId.split('_')[0])));
      allow write: if isAdmin() || (isAuth() && progressId.split('_')[0] == request.auth.uid);
    }

    // Bookmarks, the auto-populated mistake notebook, and personal per-topic
    // notes - id `${uid}_${paperId}`. Strictly private: a student's own record of
    // what they get wrong is not something a classmate should be able to read,
    // and unlike the progress collections there is no campus-admin reporting
    // need that justifies widening it, so campus staff are deliberately NOT
    // granted read access here.
    match /gate_notes/{notesId} {
      allow read:  if isAdmin() || (isAuth() && notesId.split('_')[0] == request.auth.uid);
      allow write: if isAdmin() || (isAuth() && notesId.split('_')[0] == request.auth.uid);
    }

    // Software Engineering Fundamentals - the core-platform flagship course
    // (lib/softwareEngineering.js). Global and world-readable when published,
    // exactly like programmingLanguages/csCoreSubjects/problems: the whole point
    // is that a prospective student can read the course before signing up, and
    // that search engines can index it. Drafts stay admin-only so in-progress
    // authoring never leaks.
    //
    // NOTE for any client list() here: the non-admin read branch checks
    // resource.data.status, so a query MUST carry a matching
    // where("status","==","published") filter or Firestore denies the whole
    // request - see lib/programming.js's fetchLanguages comment for the full
    // story. fetchModules/fetchLessons both do.
    match /seModules/{moduleId} {
      allow read:  if contentReadable() || isAdmin();
      allow write: if isAdmin();

      match /lessons/{lessonId} {
        allow read:  if contentReadable() || isAdmin();
        allow write: if isAdmin();
      }
    }

    // Per-user course progress - ONE document per user, keyed by uid (this is a
    // single course, unlike GATE's per-paper progress docs).
    //
    // isAdmin() is a separate TOP-LEVEL disjunct, not nested inside isAuth() -
    // see payout_requests above for why nesting breaks list(). It is needed as a
    // list() here specifically because deleting a module or lesson has to scrub
    // that id out of every learner's completedLessonIds
    // (scrubCompletedLessonIds), which is an unfiltered collection read.
    //
    // completedLessonIds.hasAll(...) makes the owner's own array MONOTONIC: once
    // a lesson id is in there the owner can never remove it, only add more.
    // Without this, arrayRemove-ing a completed id and re-triggering
    // completeLesson() would re-earn that lesson's XP/coins indefinitely - the
    // identical reward-replay exploit already closed on programming_progress,
    // cscore_progress and gate_progress. Scoped to fire only when the field is
    // actually present on the existing doc, so the first write (and the
    // notes/bookmarks/labs-only writes, which never touch it) are unaffected.
    match /se_progress/{uid} {
      allow read:  if isAdmin() || isOwner(uid);
      allow write: if isAdmin() || (isOwner(uid)
        && (resource == null
          || !('completedLessonIds' in resource.data)
          || request.resource.data.get('completedLessonIds', []).hasAll(resource.data.completedLessonIds)));
    }

    // DeVert Campus - each institution (college) is its own tenant, isolated from
    // every other one, on the same project/database. Directory listing is public
    // (browsing colleges on DeVert Campus doesn't require membership); only
    // platform isAdmin() provisions an institution or grants its first admin today
    // - self-service institution signup/admin invites are a later enhancement.
    match /institutions/{institutionId} {
      // "private" institutions are invisible to everyone except their own
      // approved students/admins (and platform isAdmin()) - both a direct
      // get() and a collection-level list() are covered by this same rule,
      // since Firestore evaluates `list` per-candidate-document too (same
      // pattern as isCompanyPublished() above): a query like fetchInstitutions()
      // silently omits private ones for a non-member instead of erroring.
      // "public"/"invite_only" institutions stay listed either way - both
      // now accept a self-serve students/{uid} submission (see below);
      // invite_only's distinction is the simplified Campus Identity
      // Verification form the client shows, not a rules-level block.
      allow read: if resource.data.get('accessMode', 'public') != 'private'
        || isApprovedStudent(institutionId) || isInstitutionAdmin(institutionId) || isAdmin();
      // Institution admins (Training & Placement Cell) may self-serve edit
      // their own campus's public branding - name/shortName/description/
      // tagline/banner/logo/accent color - plus studentCount (the Directory's
      // public "N students" stat, kept live by approveStudent/suspendStudent/
      // removeStudentFromInstitution/bulkAssignByRollNumber in
      // lib/institutions.js) - but nothing else on this doc (accessMode,
      // status, contact info, etc. stay platform-isAdmin()-only).
      // affectedKeys().hasOnly(...) makes this atomic: a write that touches
      // even one field outside the allow-list is rejected outright, not
      // partially applied. studentCount is trusted-admin-only (not a student
      // self-write), so it only needs a basic non-negative-integer sanity
      // check, not a bounded-delta pattern - a bulk roll-number import can
      // legitimately jump it by more than 1 in one write.
      allow update: if isAdmin()
        || (isInstitutionAdmin(institutionId)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['name', 'shortName', 'description', 'tagline', 'bannerUrl', 'logoUrl', 'heroAccentColor', 'studentCount'])
            && request.resource.data.studentCount is int && request.resource.data.studentCount >= 0);
      allow create, delete: if isAdmin();

      // Institution-admin membership (placement officer / faculty / dept admin /
      // TPC). Grantable only by platform isAdmin() for now.
      match /admins/{uid} {
        allow read:  if isApprovedStudent(institutionId) || isInstitutionAdmin(institutionId) || isAdmin();
        allow write: if isAdmin();
      }

      // Principal/HOD/Faculty-Class-Teacher accounts - a SEPARATE collection
      // from admins/{uid} above (see isPrincipal()/isHodOfDepartment()/
      // isFacultyOfClassroom() at the top of this file for why). Write is
      // isAdmin()-only - i.e. no legitimate CLIENT write path exists at all;
      // every account here is created/disabled/reset/re-permissioned
      // exclusively through devert-backend's AdminAccountService (Admin SDK,
      // bypassing these rules entirely, same trust boundary GradingService
      // already established for hidden test cases). A signed-in HOD may also
      // read their own department's OTHER role-assignment docs (e.g. seeing
      // which Faculty/Class Teachers are assigned in their own department in
      // the Manage Admins-equivalent view a future HOD dashboard might add) -
      // never another department's.
      match /roleAssignments/{uid} {
        allow read: if isOwner(uid) || isInstitutionAdmin(institutionId) || isAdmin()
          || isHodOfDepartment(institutionId, resource.data.get('scope', {}).get('department', ''));
        allow write: if isAdmin();
      }

      // Department-as-entity - a small fixed enum (lib/institutions.js's
      // DEPARTMENTS, ~10 per institution), seeded eagerly by
      // ensureDepartments()/createInstitution(), unlike classrooms' lazy
      // per-combination creation. `hodUid` is never client-writable from
      // ANY branch below - only AdminAccountService sets it, transactionally
      // with the matching roleAssignments write, so it can never point at a
      // uid with no real active HOD roleAssignment backing it. An HOD may
      // self-serve edit their OWN department's free-text `description` only
      // (nothing else, and only with the departments.manage permission) -
      // every other field (including hodUid) stays admin-only.
      match /departments/{departmentKey} {
        allow read: if isApprovedStudent(institutionId) || isInstitutionAdmin(institutionId) || isAdmin()
          || hasRoleAssignment(institutionId, request.auth.uid);
        allow create, delete: if isAdmin();
        allow update: if isInstitutionAdmin(institutionId) || isAdmin()
          || (isHodOfDepartment(institutionId, departmentKey)
              && hasPermission(institutionId, request.auth.uid, 'departments.manage')
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['description']));
      }

      // Audit trail for every AdminAccountService action (create/disable/
      // reset-password/permission-change) - institution-scoped, NOT the
      // existing global admin_activity_log above (that one is isAdmin()-only
      // both directions; reusing it for institution-scoped roles would mean
      // either a cross-tenant read leak or re-deriving the same
      // resource-field gymnastics payout_requests/reward_grants already show
      // scars from - a path-scoped subcollection sidesteps all of that for
      // free, same as every other institution-scoped collection here).
      // create-only from a client's perspective (the backend uses Admin SDK
      // and bypasses this anyway) - immutable once written, matching
      // reward_grants'/leaderboardSnapshots' own create-only-history pattern.
      match /adminActivityLog/{logId} {
        allow read: if isInstitutionAdmin(institutionId) || isAdmin();
        allow create: if isAdmin();
        allow update, delete: if isAdmin();
      }

      // One doc per student = BOTH the join request and the roster record, so
      // there's no separate request-then-promote step. The student creates their
      // own doc, but only ever at status 'pending' - no student may set their own
      // status, department, year, or section (that's the whole point of requiring
      // approval). Only that institution's own admin (or platform isAdmin()) can
      // transition status or assign academic fields - mirrors pulse_posts'
      // owner-creates/admin-transitions shape.
      match /students/{uid} {
        // HOD/Faculty read access is scope-matched against the roster doc's
        // OWN department/classroomId (never the caller's claimed scope) and
        // additionally requires the students.view permission - see
        // hasPermission()'s own comment for why this one read (named
        // explicitly in the spec) is permission-gated while most reads in
        // this file aren't: scope match is the real security boundary here,
        // students.view is the one place the spec asked for finer control
        // on top of it.
        allow read:   if isOwner(uid) || isInstitutionAdmin(institutionId) || isAdmin()
          || (isHodOfDepartment(institutionId, resource.data.get('department', '')) && hasPermission(institutionId, request.auth.uid, 'students.view'))
          || (isFacultyOfClassroom(institutionId, resource.data.get('classroomId', '')) && hasPermission(institutionId, request.auth.uid, 'students.view'));
        // Self-serve submission (student creates their own pending doc) is
        // accepted for every access mode now - "invite_only" no longer blocks
        // this at the rules level. The distinction lives entirely in the
        // client: "public" shows the full JoinForm, "invite_only" shows the
        // simplified Campus Identity Verification form (name + roll number +
        // department/year/section - see CampusIdentityForm). Either way this
        // is still just a pending request; that institution's own admin (or
        // platform isAdmin()) reviews and approves it exactly as before.
        // "private" doesn't need its own check here - the
        // institutions/{institutionId} read rule above already makes a
        // private institution invisible before a student could even reach a
        // join button. Department/year/section are enum/shape-validated here
        // (isValidDepartment/isValidYear above, section a single uppercase
        // letter) so a self-serve submission can't smuggle in a value the
        // canonical dropdowns never offered - this is the one enforcement
        // point, since JoinForm/CampusIdentityForm are the only client paths
        // that hit this branch (isInstitutionAdmin()/isAdmin() below stay
        // unrestricted, same as every other admin-authored field elsewhere).
        allow create: if (isOwner(uid)
            && request.resource.data.uid == uid
            && request.resource.data.status == 'pending'
            && isValidDepartment(request.resource.data.get('department', ''))
            && isValidYear(request.resource.data.get('year', ''))
            && request.resource.data.get('section', '').matches('^[A-Z]$'))
          // isInstitutionAdmin() deliberately removed from create - no
          // legitimate code path ever creates a fresh roster doc as an
          // admin (approveStudent/bulkAssignByRollNumber/updateStudentIdentity
          // all only ever update an EXISTING doc the student themselves
          // created via requestToJoin). Leaving it in let an institution
          // admin fabricate an "approved" roster entry for ANY uid who never
          // asked to join, with no consent - and chained with the
          // users/{uid} institution-membership branch below, let them then
          // read that uid's private coin/earnings/progress data outright.
          || isAdmin();
        // Update stays admin-only (institution admin or platform admin) -
        // this is also what enforces the Roll Number Lock: a student can
        // CREATE their identity submission once, but can never update it
        // themselves afterward. Admin edits after approval go through
        // updateStudentIdentity() (lib/institutions.js), which appends to
        // identityAuditLog in the same write.
        //
        // HOD/Faculty may EDIT a student already in their own scope (per
        // scope match on the roster doc's CURRENT department/classroomId,
        // same isHodOfDepartment/isFacultyOfClassroom pattern as read above,
        // plus students.edit) but may never use this to relocate a student
        // OUT of that scope - the written department/classroomId must equal
        // what it already was. Delete stays admin-only - permanently
        // removing institution membership is a bigger action than the
        // spec's "Edit Students" permission covers for either role.
        allow update: if isInstitutionAdmin(institutionId) || isAdmin()
          || (isHodOfDepartment(institutionId, resource.data.get('department', ''))
              && request.resource.data.get('department', '') == resource.data.get('department', '')
              && hasPermission(institutionId, request.auth.uid, 'students.edit'))
          || (isFacultyOfClassroom(institutionId, resource.data.get('classroomId', ''))
              && request.resource.data.get('classroomId', '') == resource.data.get('classroomId', '')
              && hasPermission(institutionId, request.auth.uid, 'students.edit'));
        allow delete: if isInstitutionAdmin(institutionId) || isAdmin();
      }

      // Duplicate-roll-number guard for requestToJoin/updateStudentIdentity
      // (lib/institutions.js) - a targeted get() by a known normalized roll
      // number reveals only "taken or not" (the doc's only fields are
      // uid/rollNumber/claimedAt), never a way to browse the roster, so this
      // stays safely readable by any signed-in user even before they've
      // joined anything. list is admin-only since that WOULD enumerate
      // every claimed roll number; normal usage never needs it.
      match /rollNumberRegistry/{key} {
        allow get: if isAuth();
        allow list: if isInstitutionAdmin(institutionId) || isAdmin();
        allow create, update: if isAuth() &&
          (request.resource.data.uid == request.auth.uid || isInstitutionAdmin(institutionId) || isAdmin());
        allow delete: if isAuth() &&
          ((resource.data != null && resource.data.uid == request.auth.uid) || isInstitutionAdmin(institutionId) || isAdmin());
      }

      // Pure identity metadata (department/year/section/createdAt) for one
      // Department+Year+Section combination - never a place statistics get
      // denormalized (see ensureClassroom's comment in lib/institutions.js
      // for why: no Cloud Functions in this project means nothing would keep
      // a stored count/average in sync). Auto-created by ensureClassroom()
      // from approveStudent/bulkAssignByRollNumber, both already
      // institution-admin-gated - students never write here directly, only
      // read their own classroom's metadata (name shown in the UI, e.g.
      // "III Year - CSE(AI&ML) - A").
      match /classrooms/{classroomId} {
        allow read: if isApprovedStudent(institutionId) || isInstitutionAdmin(institutionId) || isAdmin()
          || isHodOfDepartment(institutionId, resource.data.get('department', '')) || isFacultyOfClassroom(institutionId, classroomId);
        allow create: if isInstitutionAdmin(institutionId) || isAdmin();
        // HOD/Faculty updates are bounded to moduleAccess/leaderboardVisibility
        // only (affectedKeys().hasOnly(...), same bounded-write idiom used
        // throughout this file) - department/year/section/createdAt/
        // classTeacherUid stay admin-only (classTeacherUid specifically is
        // only ever set by AdminAccountService, transactionally with the
        // matching roleAssignments write - see that collection's own
        // comment). An HOD may touch any classroom in their OWN department;
        // Faculty only their OWN single assigned classroom.
        allow update: if isInstitutionAdmin(institutionId) || isAdmin()
          || (isHodOfDepartment(institutionId, resource.data.get('department', ''))
              && hasPermission(institutionId, request.auth.uid, 'classrooms.manage')
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['moduleAccess', 'leaderboardVisibility']))
          || (isFacultyOfClassroom(institutionId, classroomId)
              && hasPermission(institutionId, request.auth.uid, 'classrooms.manage')
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['moduleAccess', 'leaderboardVisibility']));
      }

      // Institution-wide settings docs (currently just "leaderboard" - see
      // lib/institutions.js's fetchLeaderboardSettings/saveLeaderboardSettings).
      // Approved students need read access so their own Leaderboard tab can
      // see which scopes/metric the campus admin has configured; only that
      // institution's own admin (or platform isAdmin()) may change it.
      match /settings/{settingId} {
        allow read:  if isApprovedStudent(institutionId) || isInstitutionAdmin(institutionId) || isAdmin();
        allow write: if isInstitutionAdmin(institutionId) || isAdmin();
      }

      // Immutable weekly leaderboard snapshots (lib/institutions.js's
      // announceWeeklyLeaderboard) - approved students read their own
      // campus's frozen weekly rankings; only that institution's own admin
      // (or platform isAdmin()) may create one, and never update/delete -
      // once announced, a snapshot is a historical record, not a live
      // document to be edited.
      match /leaderboardSnapshots/{weekId} {
        allow read:   if isApprovedStudent(institutionId) || isInstitutionAdmin(institutionId) || isAdmin();
        allow create: if isInstitutionAdmin(institutionId) || isAdmin();
        allow update, delete: if isAdmin();
      }

      // Admin-authored content, visible only to that institution's own approved
      // students and admins - unlike courses/aptitude_topics (public read), Campus
      // content is the whole reason institutions get isolated workspaces.
      // scopeDepartment/scopeClassroomId are optional (absent = institution-
      // wide, same "optional field, broadest default" idiom contests'
      // institutionId field already uses) - they let an HOD/Faculty publish
      // scoped to their own department/classroom without touching the
      // institution-wide catalog admins/Principal manage.
      match /dailyLearning/{itemId} {
        allow read:  if isApprovedStudent(institutionId) || isInstitutionAdmin(institutionId) || isAdmin()
          || isHodOfDepartment(institutionId, resource.data.get('scopeDepartment', '')) || isFacultyOfClassroom(institutionId, resource.data.get('scopeClassroomId', ''));
        // create/update only - delete stays admin-only below (deliberately
        // NOT combined into one `allow write`: request.resource is null on a
        // delete, and dereferencing request.resource.data on that throws in
        // rules, which would deny the WHOLE expression this is OR'd into -
        // same failure mode this file's reward_grants comment already
        // documents - so these two new HOD/Faculty branches must never be
        // evaluated on a delete at all).
        //
        // The existing resource's own scope must already match the caller's
        // scope too (not just the incoming write) - an HOD/Faculty can
        // create a new scoped item or edit one already in their scope, but
        // can never "adopt" an existing institution-wide or other-scope item
        // by simply relabeling its scope field in the same write.
        allow create, update: if isInstitutionAdmin(institutionId) || isAdmin()
          || (isHodOfDepartment(institutionId, request.resource.data.get('scopeDepartment', ''))
              && (resource == null || resource.data.get('scopeDepartment', '') == request.resource.data.get('scopeDepartment', ''))
              && hasPermission(institutionId, request.auth.uid, 'dailyLearning.publish'))
          || (isFacultyOfClassroom(institutionId, request.resource.data.get('scopeClassroomId', ''))
              && (resource == null || resource.data.get('scopeClassroomId', '') == request.resource.data.get('scopeClassroomId', ''))
              && hasPermission(institutionId, request.auth.uid, 'dailyLearning.publish'));
        allow delete: if isInstitutionAdmin(institutionId) || isAdmin();
      }

      // A student's own per-day completion record (mcq answers/score,
      // problems solved, xp/coin earned) - readable by any approved peer
      // (that's what makes a day-filtered leaderboard possible) but only
      // the owning student (or an admin) can ever write their own row, and
      // only while genuinely enrolled - same isOwner+isApprovedStudent
      // shape as the rest of this Daily Learning feature.
      match /dailyLearningLog/{logId} {
        // isHodOfStudent/isFacultyOfStudent (not isHodOfDepartment/
        // isFacultyOfClassroom directly - these log docs carry no
        // department/classroomId of their own) look up THIS log's own uid's
        // roster doc to check scope, same as user_earnings/coin_transactions/
        // codelab_submissions above already do. Paired with
        // fetchLogsForDateByUids (lib/classroomAnalytics.js) actually scoping
        // the query itself to that HOD/Faculty's own cohort - without that,
        // an unscoped date-only list query would still be denied in full the
        // instant it returned even one other department's log (Classroom/
        // Department Analytics' "Couldn't load analytics" bug).
        allow read:  if isApprovedStudent(institutionId) || isInstitutionAdmin(institutionId) || isAdmin()
          || isHodOfStudent(resource.data.uid) || isFacultyOfStudent(resource.data.uid);
        // completedAt is monotonic for a student's own write: once set, that
        // exact write is what submitDayCompletion's transaction checks to
        // decide "already rewarded" - without this, a student could call the
        // Firestore SDK directly to delete/change their own completedAt and
        // resubmit through the normal UI to replay the day's xp/score/coins
        // reward indefinitely. Institution admins/platform admins are exempt
        // (legitimate corrections), not the owner.
        //
        // logId.split('_')[0] == request.auth.uid ties the doc ID itself to
        // the caller, matching programming_progress/cscore_progress/
        // user_activity_daily's identical pattern - without it, isOwner()
        // only checked the PAYLOAD's uid field, not which uid's log slot was
        // actually being targeted, letting one approved student write into
        // ANY other student's institutions/{id}/dailyLearningLog/{victim}_{date}
        // doc (payload uid spoofed to their own) - pre-setting completedAt to
        // silently deny the victim's real future reward, or, once set,
        // overwriting mcqAnswers/mcqScore/displayName/rollNumber under the
        // victim's slot. xpEarned/coinEarned are also now bounded (matching
        // reward_grants' own 2000 ceiling) - previously a student's own
        // legitimate write could set these to anything, forging the day
        // leaderboard's sort key and the institution's Classroom Analytics.
        allow write: if isInstitutionAdmin(institutionId) || isAdmin() ||
          (isApprovedStudent(institutionId) && isOwner(request.resource.data.uid)
            && logId.split('_')[0] == request.auth.uid
            && isModuleEnabledForUser(request.resource.data.uid, institutionId, 'dailyLearning')
            && (resource == null || !('completedAt' in resource.data) || request.resource.data.completedAt == resource.data.completedAt)
            && request.resource.data.get('xpEarned', 0) is number && request.resource.data.get('xpEarned', 0) >= 0 && request.resource.data.get('xpEarned', 0) <= 2000
            && request.resource.data.get('coinEarned', 0) is number && request.resource.data.get('coinEarned', 0) >= 0 && request.resource.data.get('coinEarned', 0) <= 2000
            // Same-day rule: a day may only claim XP/coins on the day it is
            // FOR. lib/dailyLearning.js's submitDayCompletion applies this
            // client-side, but that is the UX - coins convert to real INR, so
            // it is enforced here too. Without this, the client check is a
            // one-line bypass through the SDK.
            //
            // A late day may still be written (progress, streak history and
            // analytics all keep working) - it just cannot carry a nonzero
            // reward. Institution/platform admins are exempt above, so
            // legitimate corrections are unaffected.
            && (isRewardFreeLog() || request.resource.data.get('date', '') == istTodayStr()));
      }

      // New tracks within Daily Learning (Aptitude Series first - see
      // lib/dailyLearning.js's TRACK_CATALOG/trackPaths) live in their own
      // namespaced subtree instead of the legacy dailyLearning/
      // dailyLearningLog collections above - that keeps every existing DSA
      // item/log doc ID (a bare calendar date, and {uid}_{date} respectively)
      // completely untouched, so a second calendar-paced track can never
      // collide with a DSA item/log sharing the same real date. Same read/
      // write shape as dailyLearning/dailyLearningLog above (including the
      // HOD/Faculty scoped-publish disjuncts and the monotonic-completedAt/
      // bounded-xp-coin log write), just parameterized by trackId instead of
      // a fixed top-level collection name - still gated on the dailyLearning
      // module (a track within Daily Learning, not a separate toggleable
      // module).
      match /learningTracks/{trackId} {
        match /items/{date} {
          allow read:  if isApprovedStudent(institutionId) || isInstitutionAdmin(institutionId) || isAdmin()
            || isHodOfDepartment(institutionId, resource.data.get('scopeDepartment', '')) || isFacultyOfClassroom(institutionId, resource.data.get('scopeClassroomId', ''));
          allow create, update: if isInstitutionAdmin(institutionId) || isAdmin()
            || (isHodOfDepartment(institutionId, request.resource.data.get('scopeDepartment', ''))
                && (resource == null || resource.data.get('scopeDepartment', '') == request.resource.data.get('scopeDepartment', ''))
                && hasPermission(institutionId, request.auth.uid, 'dailyLearning.publish'))
            || (isFacultyOfClassroom(institutionId, request.resource.data.get('scopeClassroomId', ''))
                && (resource == null || resource.data.get('scopeClassroomId', '') == request.resource.data.get('scopeClassroomId', ''))
                && hasPermission(institutionId, request.auth.uid, 'dailyLearning.publish'));
          allow delete: if isInstitutionAdmin(institutionId) || isAdmin();
        }
        match /logs/{logId} {
          // Mirrors dailyLearningLog's own isHodOfStudent/isFacultyOfStudent
          // disjunct above - see that rule's comment for why (log docs carry
          // no department/classroomId of their own, so scope is resolved via
          // the log's own uid's roster doc instead).
          allow read:  if isApprovedStudent(institutionId) || isInstitutionAdmin(institutionId) || isAdmin()
            || isHodOfStudent(resource.data.uid) || isFacultyOfStudent(resource.data.uid);
          allow write: if isInstitutionAdmin(institutionId) || isAdmin() ||
            (isApprovedStudent(institutionId) && isOwner(request.resource.data.uid)
              && logId.split('_')[0] == request.auth.uid
              && isModuleEnabledForUser(request.resource.data.uid, institutionId, 'dailyLearning')
              && (resource == null || !('completedAt' in resource.data) || request.resource.data.completedAt == resource.data.completedAt)
              && request.resource.data.get('xpEarned', 0) is number && request.resource.data.get('xpEarned', 0) >= 0 && request.resource.data.get('xpEarned', 0) <= 2000
              && request.resource.data.get('coinEarned', 0) is number && request.resource.data.get('coinEarned', 0) >= 0 && request.resource.data.get('coinEarned', 0) <= 2000);
        }
      }

      // Institution-local hide list for global, platform-owned content
      // (companies/problems) - lets a campus admin curate what THEIR
      // students see without ever writing to those global collections
      // (which stay isAdmin()-only and shared across every institution).
      match /contentVisibility/{docId} {
        allow read:  if isApprovedStudent(institutionId) || isInstitutionAdmin(institutionId) || isAdmin();
        allow write: if isInstitutionAdmin(institutionId) || isAdmin();
      }

      // Student Management's "send announcements to selected students" -
      // an admin-authored announcement optionally carries a targetUids list;
      // omitted/empty means institution-wide broadcast (existing behavior),
      // present means only those students (plus admins) may read it.
      match /announcements/{announcementId} {
        allow read: if isInstitutionAdmin(institutionId) || isAdmin() || (isApprovedStudent(institutionId) &&
          (!('targetUids' in resource.data) || resource.data.targetUids.size() == 0 || request.auth.uid in resource.data.targetUids));
        allow write: if isInstitutionAdmin(institutionId) || isAdmin();
      }

      // Contest Studio's per-institution question bank - reusable questions an
      // admin can drop into any of their own contests. Never read by students
      // (unlike dailyLearning/announcements above) - it's an authoring tool,
      // not published content.
      match /questionBank/{questionId} {
        allow read, write: if isInstitutionAdmin(institutionId) || isAdmin();
      }
    }
  }
}
