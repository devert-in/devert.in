rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuth() && request.auth.token.email == 'adari.samuel.prasad@udyogahconnect.com';
    }

    // Users — any logged-in user can read profiles; only owner/admin can write
    match /users/{uid} {
      allow read:           if isAuth();
      allow create:         if isOwner(uid);
      allow update:         if isOwner(uid) || isAdmin();
      allow delete:         if isAdmin();
    }

    // Projects (Shipyard) — public read, owner writes
    match /projects/{projectId} {
      allow read:           if true;
      allow create:         if isAuth() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAuth() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // Missions — admin creates, public reads
    match /missions/{missionId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // User missions — owner + admin
    match /user_missions/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
      match /progress/{missionId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
    }

    // Arena matches
    match /arena_matches/{matchId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAdmin();
    }

    // Grind log (daily problems per user)
    match /grind_log/{uid}/entries/{entryId} {
      allow read:  if isAuth();
      allow write: if isOwner(uid);
    }

    // Leaderboard — public read, admin writes
    match /leaderboard/{uid} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // System config & feature flags
    match /system/{document=**} {
      allow read:  if true;
      allow write: if isAdmin();
    }
  }
}
