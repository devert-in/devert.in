rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin (requires custom claim or specific email)
    function isAdmin() {
       return request.auth != null && request.auth.token.email == 'admin@devert.in';
    }

    // Placements Prep role helpers (used by /users rules below as well as prep* collections)
    function userDoc(uid) { return get(/databases/$(database)/documents/users/$(uid)).data; }
    function myRole() { return request.auth != null ? userDoc(request.auth.uid).get('role', 'student') : 'none'; }
    function isStaff() { return request.auth != null && (myRole() in ['faculty', 'tpo', 'admin'] || request.auth.token.email == 'admin@devert.in'); }
    function isPrepAdmin() { return request.auth != null && (myRole() == 'admin' || request.auth.token.email == 'admin@devert.in'); }
    function examData(examId) { return get(/databases/$(database)/documents/prepExams/$(examId)).data; }
    // Grace window (design §4/§5: submissionGraceSecs, default 120s) so a debounced
    // autosave or final submit that lands microseconds after endsAt isn't rejected.
    function examEndsWithGrace(examId) { return examData(examId).endsAt + duration.value(120, 's'); }

    // Hackathons: Anyone can read, only Admins can write
    match /hackathons/{hackathonId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (request.auth != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants']));
    }

    // Sprints (Replacements for Hackathons): Anyone can read, only Admins can write
    match /sprints/{sprintId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (request.auth != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants']));
    }

    // Courses: Anyone can read, only Admins can write
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Postmortems: Anyone can read, only Admins can write
    match /postmortems/{pmId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Bounties: Anyone can read, only Admins can write
    match /bounties/{bountyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Contests: Anyone can read, Auth users can create (propose), Admins can manage, Hosts can edit their own
    match /contests/{contestId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow delete: if isAdmin();
      allow update: if isAdmin()
        || (request.auth != null && resource.data.host == request.auth.token.email)
        || (request.auth != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants']));
    }

    // Users: Users can read/write their own data
    match /users/{userId} {
      allow read: if (request.auth != null && request.auth.uid == userId) || isAdmin() || isStaff();
      allow create: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      allow update: if isPrepAdmin()
        || (request.auth != null && request.auth.uid == userId
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      allow delete: if isAdmin();
    }

    // Squadron: Anyone can read, Authenticated users can post, Owners/Admins can delete
    match /squadron/{docId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Incubator Ideas: Public read, Auth create, Voting allowed
    match /incubator_ideas/{ideaId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Challenge Registrations: Auth create
    match /challenge_registrations/{regId} {
      allow read, write: if request.auth != null;
    }

    // System Settings & Feature Flags (Critical for UI Toggles)
    match /system/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Legacy support if needed
    match /system_settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ────────────────────────────────────────────────────────────
    // Placements Prep module
    // ────────────────────────────────────────────────────────────

    match /prepQuestions/{qid} {
      allow read: if request.auth != null;
      allow write: if isPrepAdmin();
    }

    match /prepCourses/{courseId} {
      allow read: if request.auth != null;
      allow write: if isStaff();
    }

    match /prepDailyTasks/{dateId} {
      allow read: if request.auth != null;
      allow write: if isStaff();
    }

    match /prepClassGroups/{groupId} {
      allow read: if request.auth != null;
      allow write: if isStaff();
    }

    match /prepAnnouncements/{annId} {
      allow read: if request.auth != null;
      allow write: if isStaff();
    }

    match /prepExams/{examId} {
      allow read: if isStaff() || (request.auth != null && resource.data.published == true);
      allow write: if isStaff();
    }

    match /prepExamPapers/{examId} {
      allow read: if isStaff()
        || (request.auth != null
            && examData(examId).published == true
            && request.time >= examData(examId).startsAt);
      allow write: if isStaff();
    }

    match /prepExamKeys/{examId} {
      allow read: if isStaff()
        || (request.auth != null && request.time > examData(examId).endsAt);
      allow write: if isStaff();
    }

    match /prepSubmissions/{subId} {
      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid || isStaff());

      allow create: if request.auth != null
        && subId == request.resource.data.examId + '_' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && examData(request.resource.data.examId).published == true
        && request.time >= examData(request.resource.data.examId).startsAt
        && request.time <= examEndsWithGrace(request.resource.data.examId)
        && request.resource.data.rollNumber == userDoc(request.auth.uid).get('rollNumber', null);

      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && resource.data.status != 'submitted'
        && request.time <= examEndsWithGrace(resource.data.examId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.examId == resource.data.examId;

      allow delete: if isPrepAdmin();
    }

    match /prepAttempts/{uid}/records/{attemptId} {
      allow read: if request.auth != null && (request.auth.uid == uid || isStaff());
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Collection-group read for staff dashboards across all students
    match /{path=**}/records/{attemptId} {
      allow read: if isStaff();
    }

    match /prepProgress/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isStaff());
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
