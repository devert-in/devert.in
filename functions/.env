# Not a secret - the Cloud Run backend URL is already plaintext in
# .github/workflows/deploy-prod.yml/deploy-mock.yml. Firebase Functions v2
# auto-loads this file at deploy time (see https://firebase.google.com/docs/functions/config-env).
# uHandleRouter/contestPreviewRouter/campusPreviewRouter/pulsePreviewRouter all
# read this to fetch real preview HTML from devert-backend for crawlers.
DEVERT_BACKEND_URL=https://devert-backend-550891323057.asia-south1.run.app

# Razorpay KEY ID only. This is the publishable half of the pair - it is handed
# to every browser that opens Checkout, so it is not a secret and belongs here
# next to DEVERT_BACKEND_URL.
#
# The KEY SECRET is deliberately NOT in this file. functions/.env is committed
# (see the !functions/.env negation in .gitignore), so anything written here ends
# up in git. The secret is held in Google Secret Manager instead and injected at
# runtime via defineSecret() - see index.js. Set it once with:
#   npx firebase-tools functions:secrets:set RAZORPAY_KEY_SECRET --project devert-me
RAZORPAY_KEY_ID=rzp_test_TNGNrAtt4VYg80
