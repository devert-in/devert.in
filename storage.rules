rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // User avatars - public read, owner writes (max 2MB, images only)
    match /avatars/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Project screenshots - public read, owner writes (max 5MB)
    match /projects/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024;
    }

    // Pulse post images - public read, any auth user writes (max 8MB, images only)
    match /pulse_images/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Intel resources - public read, admin writes (custom claim, see
    // scripts/set-admin-claim.mjs - matches the Firestore admin model)
    match /intel-resources/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.admin == true;
    }
  }
}
