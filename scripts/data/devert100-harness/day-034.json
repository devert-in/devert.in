{
  "kind": "function",
  "className": "Solution",
  "functions": [
    {
      "name": "getIntersectionNode",
      "params": [
        {
          "name": "headA",
          "type": "ListNode",
          "build": {
            "intersection": {
              "listA": "listA",
              "listB": "listB",
              "skipA": "skipA",
              "skipB": "skipB",
              "side": "A"
            }
          }
        },
        {
          "name": "headB",
          "type": "ListNode",
          "build": {
            "intersection": {
              "listA": "listA",
              "listB": "listB",
              "skipA": "skipA",
              "skipB": "skipB",
              "side": "B"
            }
          }
        }
      ],
      "returns": "ListNode"
    }
  ],
  "inputs": [
    {
      "name": "intersectVal",
      "type": "int"
    },
    {
      "name": "listA",
      "type": "int[]"
    },
    {
      "name": "listB",
      "type": "int[]"
    },
    {
      "name": "skipA",
      "type": "int"
    },
    {
      "name": "skipB",
      "type": "int"
    }
  ],
  "output": {
    "mode": "nodeVal"
  },
  "cases": [
    {
      "label": "Example 1",
      "input": {
        "intersectVal": 8,
        "listA": [
          4,
          1,
          8,
          4,
          5
        ],
        "listB": [
          5,
          6,
          1,
          8,
          4,
          5
        ],
        "skipA": 2,
        "skipB": 3
      },
      "expected": 8
    },
    {
      "label": "Example 2",
      "input": {
        "intersectVal": 2,
        "listA": [
          1,
          9,
          1,
          2,
          4
        ],
        "listB": [
          3,
          2,
          4
        ],
        "skipA": 3,
        "skipB": 1
      },
      "expected": 2
    },
    {
      "label": "Example 3",
      "input": {
        "intersectVal": 0,
        "listA": [
          2,
          6,
          4
        ],
        "listB": [
          1,
          5
        ],
        "skipA": 3,
        "skipB": 2
      },
      "expected": null
    },
    {
      "label": "Same values, no shared node",
      "input": {
        "intersectVal": 0,
        "listA": [
          1,
          2,
          3
        ],
        "listB": [
          1,
          2,
          3
        ],
        "skipA": 3,
        "skipB": 3
      },
      "expected": null
    },
    {
      "label": "A lies entirely inside B",
      "input": {
        "intersectVal": 3,
        "listA": [
          3,
          4
        ],
        "listB": [
          2,
          3,
          4
        ],
        "skipA": 0,
        "skipB": 1
      },
      "expected": 3
    }
  ]
}
