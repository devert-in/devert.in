{
  "kind": "function",
  "className": "Solution",
  "functions": [
    {
      "name": "kClosest",
      "params": [
        {
          "name": "points",
          "type": "int[][]"
        },
        {
          "name": "k",
          "type": "int"
        }
      ],
      "returns": "int[][]"
    }
  ],
  "check": "unordered",
  "cases": [
    {
      "label": "Example 1",
      "input": {
        "points": [
          [
            1,
            3
          ],
          [
            -2,
            2
          ]
        ],
        "k": 1
      },
      "expected": [
        [
          -2,
          2
        ]
      ]
    },
    {
      "label": "Example 2",
      "input": {
        "points": [
          [
            3,
            3
          ],
          [
            5,
            -1
          ],
          [
            -2,
            4
          ]
        ],
        "k": 2
      },
      "expected": [
        [
          3,
          3
        ],
        [
          -2,
          4
        ]
      ]
    },
    {
      "label": "k equals n",
      "input": {
        "points": [
          [
            1,
            1
          ],
          [
            2,
            2
          ]
        ],
        "k": 2
      },
      "expected": [
        [
          2,
          2
        ],
        [
          1,
          1
        ]
      ]
    },
    {
      "label": "Duplicate points",
      "input": {
        "points": [
          [
            1,
            1
          ],
          [
            1,
            1
          ],
          [
            3,
            3
          ]
        ],
        "k": 2
      },
      "expected": [
        [
          1,
          1
        ],
        [
          1,
          1
        ]
      ]
    },
    {
      "label": "Equal distances, any quadrant",
      "input": {
        "points": [
          [
            1,
            0
          ],
          [
            0,
            1
          ],
          [
            -1,
            0
          ],
          [
            3,
            3
          ]
        ],
        "k": 3
      },
      "expected": [
        [
          0,
          1
        ],
        [
          -1,
          0
        ],
        [
          1,
          0
        ]
      ]
    }
  ]
}
