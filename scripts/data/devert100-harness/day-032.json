      "input": {
        "list1": [
          1,
          2,
          4
        ],
        "list2": [
          1,
          3,
          4
        ]
      },
      "expected": [
        1,
        1,
        2,
        3,
        4,
        4
      ]
    },
    {
      "label": "Example 2",
      "input": {
        "list1": [],
        "list2": []
      },
      "expected": []
    },
    {
      "label": "Example 3",
      "input": {
        "list1": [],
        "list2": [
          0
        ]
      },
      "expected": [
        0
      ]
    },
    {
      "label": "One list entirely larger",
      "input": {
        "list1": [
          4,
          5,
          6
        ],
        "list2": [
          1,
          2,
          3
        ]
      },
      "expected": [
