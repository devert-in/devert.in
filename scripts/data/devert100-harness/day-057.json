{
  "kind": "function",
  "className": "Solution",
  "functions": [
    {
      "name": "isValidBST",
      "params": [
        {
          "name": "root",
          "type": "TreeNode"
        }
      ],
      "returns": "boolean"
    }
  ],
  "cases": [
    {
      "label": "Example 1",
      "input": {
        "root": [
          2,
          1,
          3
        ]
      },
      "expected": true
    },
    {
      "label": "Example 2",
      "input": {
        "root": [
          5,
          1,
          4,
          null,
          null,
          3,
          6
        ]
      },
      "expected": false
    },
    {
      "label": "Grandchild breaks the bound",
      "input": {
        "root": [
          5,
          4,
          6,
          null,
          null,
          3,
          7
        ]
      },
      "expected": false
    },
    {
      "label": "Duplicates",
      "input": {
        "root": [
          2,
          2,
          2
        ]
      },
      "expected": false
    },
    {
      "label": "Integer.MAX_VALUE",
      "input": {
        "root": [
          2147483647
        ]
      },
      "expected": true
    }
  ]
}
