          ],
          [
            1,
            1
          ]
        ]
      },
      "expected": [
        1,
        1,
        1,
        1,
        1
      ]
    },
    {
      "label": "Negative values",
      "input": {
        "lists": [
          [
            -3,
            -1
          ],
          [
            -2,
            0
          ]
        ]
      },
      "expected": [
        -3,
        -2,
        -1,
        0
      ]
    }
  ]
