      "input": {
        "lists": [
          [
            1,
            4,
            5
          ],
          [
            1,
            3,
            4
          ],
          [
            2,
            6
          ]
        ]
      },
      "expected": [
        1,
        1,
        2,
        3,
        4,
        4,
        5,
        6
      ]
    },
    {
      "label": "Example 2",
      "input": {
        "lists": []
      },
      "expected": []
    },
    {
      "label": "Example 3",
      "input": {
        "lists": [
          []
        ]
      },
      "expected": []
    },
    {
      "label": "Some lists empty",
      "input": {
        "lists": [
          [],
          [
            1
          ],
          []
        ]
      },
      "expected": [
        1
      ]
    },
    {
      "label": "Duplicates across lists",
      "input": {
        "lists": [
          [
            1,
            1
          ],
          [
