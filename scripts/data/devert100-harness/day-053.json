{
  "kind": "function",
  "className": "Solution",
  "functions": [
    {
      "name": "invertTree",
      "params": [
        {
          "name": "root",
          "type": "TreeNode"
        }
      ],
      "returns": "TreeNode"
    }
  ],
  "cases": [
    {
      "label": "Example 1",
      "input": {
        "root": [
          4,
          2,
          7,
          1,
          3,
          6,
          9
        ]
      },
      "expected": [
        4,
        7,
        2,
        9,
        6,
        3,
        1
      ]
    },
    {
      "label": "Example 2",
      "input": {
        "root": [
          2,
          1,
          3
        ]
      },
      "expected": [
        2,
        3,
        1
      ]
    },
    {
      "label": "Example 3",
      "input": {
        "root": []
      },
      "expected": []
    },
    {
      "label": "Only a left child",
      "input": {
        "root": [
          1,
          2
        ]
      },
      "expected": [
        1,
        null,
        2
      ]
    },
    {
      "label": "Lopsided tree",
      "input": {
        "root": [
          1,
          2,
          null,
          3,
          4
        ]
      },
      "expected": [
        1,
        null,
        2,
        4,
        3
      ]
    }
  ]
}
