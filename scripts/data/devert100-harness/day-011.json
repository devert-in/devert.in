    {
      "label": "Example 2",
      "input": {
        "strs": [
          "dog",
          "racecar",
          "car"
        ]
      },
      "expected": ""
    },
    {
      "label": "Single string",
      "input": {
        "strs": [
          "alone"
        ]
      },
      "expected": "alone"
    },
    {
      "label": "An empty string",
      "input": {
        "strs": [
          "abc",
          ""
        ]
      },
      "expected": ""
    },
    {
      "label": "First string is longer",
      "input": {
