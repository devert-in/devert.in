# =====================
# Environment files
# =====================
.env
.env.local
# functions/.env holds only DEVERT_BACKEND_URL - a public Cloud Run URL, not a
# secret (it's already plaintext in the CI workflow files) - Firebase's own
# functions deploy tooling reads this file to set the live env var, so it has
# to actually ship in the repo/CI checkout, unlike every other .env above.
!functions/.env

# Emulator-only secret values (Firebase reads these for defineSecret params when
# running locally, since Secret Manager is not reachable from the emulator).
# These ARE real secrets - unlike functions/.env above, this must never ship.
# The negation for functions/.env is deliberately narrow, so it does not rescue
# this file too, but it is listed explicitly rather than left to inference.
functions/.secret.local
.secret.local
**/.secret.local

