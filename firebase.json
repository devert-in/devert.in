{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default"
    }
  ],
  "hosting": [
    {
      "target": "main",
      "public": "devert-frontend/out",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "cleanUrls": true,
      "trailingSlash": false,
      "headers": [
        {
          "source": "/_next/static/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ],
      "redirects": [
        {
          "source": "/campus",
          "destination": "https://campus.devert.in/",
          "type": 301
        },
        {
          "source": "/campus/:splat*",
          "destination": "https://campus.devert.in/:splat*",
          "type": 301
        },
        {
          "source": "/manage",
          "destination": "/admin?tab=platform&section=features",
          "type": 301
        },
        {
          "source": "/hackathons",
          "destination": "/events",
          "type": 301
        },
        {
          "source": "/careers",
          "destination": "https://careers.devert.in/",
          "type": 301
        },
        {
          "source": "/careers/:splat*",
          "destination": "https://careers.devert.in/:splat*",
          "type": 301
        }
      ],
      "rewrites": [
        {
          "source": "/api/auth/**",
          "run": {
            "serviceId": "devert-backend",
            "region": "asia-south1"
          }
        },
        {
          "source": "/u/**",
          "function": "uHandleRouter"
        },
        {
          "source": "/campus/**",
          "function": "campusPreviewRouter"
        },
        {
          "source": "/contest/**",
          "function": "contestPreviewRouter"
        },
        {
          "source": "/pulse/**",
          "function": "pulsePreviewRouter"
        }
      ]
    },
    {
      "target": "campus",
      "public": "devert-campus/out",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "cleanUrls": true,
      "trailingSlash": false,
      "headers": [
        {
          "source": "/_next/static/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/api/auth/**",
          "run": {
            "serviceId": "devert-backend",
            "region": "asia-south1"
          }
        }
      ]
    },
    {
      "target": "careers",
      "public": "devert-careers/out",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "cleanUrls": true,
      "trailingSlash": false,
      "headers": [
        {
          "source": "/_next/static/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    }
  ],
  "storage": [
    {
      "bucket": "devert-me.firebasestorage.app",
      "rules": "storage.rules"
    }
  ],
  "emulators": {
    "firestore": {
      "port": 8089
    }
  }
}
